<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js password-template">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {{ content_for_header }}

    <style>
      :root {
        --color-primary: {{ settings.color_primary }};
        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-bg-dark: {{ settings.color_background_dark }};
        --color-text: {{ settings.color_text }};
        --color-text-muted: {{ settings.color_text_muted }};
        --color-text-invert: {{ settings.color_text_invert }};
        --color-border: {{ settings.color_border }};
        --color-input-border: {{ settings.color_input_border }};
        --button-radius: {{ settings.button_radius }}px;
      }
    </style>

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>
  <body class="template-password">
    <main role="main" class="password-main">
      {{ content_for_layout }}
    </main>
    <footer class="password-footer">
      {{ shop.name | link_to: routes.root_url }} &copy; {{ 'now' | date: '%Y' }}
    </footer>
  </body>
</html>
