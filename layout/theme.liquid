<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- capture seo_title -%}
      {%- if request.page_type == 'search' and search.performed -%}
        {{ 'general.search.results' | t: terms: search.terms }}
      {%- else -%}
        {{ page_title }}
      {%- endif -%}
      {%- if current_tags -%}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{%- endif -%}
      {%- if current_page != 1 -%} &ndash; {{ 'general.meta.page' | t: page: current_page }}{%- endif -%}
      {%- unless page_title contains shop.name -%} &ndash; {{ shop.name }}{%- endunless -%}
    {%- endcapture -%}
    <title>{{ seo_title }}</title>

    {%- capture meta_description -%}
      {%- if page_description -%}
        {{ page_description }}
      {%- elsif shop.description != blank -%}
        {{ shop.description }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    {%- endcapture -%}
    <meta name="description" content="{{ meta_description | escape }}">

    {%- comment -%} Open Graph / Twitter social meta {%- endcomment -%}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ seo_title | strip | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
    <meta property="og:description" content="{{ meta_description | escape }}">
    {%- if page_image -%}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seo_title | strip | escape }}">
    <meta name="twitter:description" content="{{ meta_description | escape }}">
    {%- if page_image -%}
      <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- endif -%}

    {%- comment -%} Structured data: Organization + WebSite {%- endcomment -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}}
    </script>
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"WebSite","name":{{ shop.name | json }},"url":{{ shop.url | json }}}
    </script>

    {%- comment -%} Structured data: BreadcrumbList {%- endcomment -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | append: '/' | json }}}{%- if request.page_type == 'product' and product -%},{"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ canonical_url | json }}}{%- elsif request.page_type == 'collection' and collection -%},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}}{%- elsif request.page_type == 'article' and article -%},{"@type":"ListItem","position":2,"name":{{ article.title | json }},"item":{{ canonical_url | json }}}{%- elsif request.page_type == 'page' and page -%},{"@type":"ListItem","position":2,"name":{{ page.title | json }},"item":{{ canonical_url | json }}}{%- endif -%}]}
    </script>

    {{ content_for_header }}

    <style>
      {{ settings.heading_font | font_face: font_display: 'swap' }}
      {{ settings.body_font | font_face: font_display: 'swap' }}

      :root {
        /* ---- Color: brand ---- */
        --color-primary: {{ settings.color_primary }};
        --color-primary-hover: {{ settings.color_primary_hover }};
        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-bg-dark: {{ settings.color_background_dark }};
        --color-text: {{ settings.color_text }};
        --color-text-muted: {{ settings.color_text_muted }};
        --color-text-invert: {{ settings.color_text_invert }};
        --color-border: {{ settings.color_border }};
        --color-input-border: {{ settings.color_input_border }};
        /* ---- Color: semantic ---- */
        --color-success: #30d158;
        --color-success-bg: color-mix(in srgb, #30d158 12%, transparent);
        --color-success-text: #1a7d3a;
        --color-error: #ff3b30;
        --color-error-bg: color-mix(in srgb, #ff3b30 12%, transparent);
        --color-error-text: #c5300a;
        --color-warning: #ff9f0a;
        --color-info: var(--color-primary);
        /* ---- Layout ---- */
        --page-width: {{ settings.page_width }}px;
        --section-spacing: {{ settings.spacing_sections }}px;
        --header-height: 60px; /* synced with header min-height 52 + padding-block 10*2; scrolled → 56 */
        --grid-gap: 22px; /* default grid gap; sections may override locally */
        /* ---- Typography ---- */
        --heading-font: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
        --body-font: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
        --heading-base-size: {{ settings.heading_base_size }}px;
        --body-base-size: {{ settings.body_base_size }}px;
        --line-height: {{ settings.line_height }};
        /* Font scale (fluid clamp values) */
        --fs-display: clamp(3rem, 8vw, 7rem);
        --fs-h1: clamp(2.75rem, 6vw + 1rem, 5.5rem);
        --fs-h2: clamp(2.25rem, 4vw + 0.5rem, 4rem);
        --fs-h3: clamp(1.5rem, 2.5vw + 0.5rem, 2.5rem);
        --fs-h4: clamp(1.25rem, 1.5vw + 0.5rem, 1.875rem);
        --fs-h5: 1.25rem;
        --fs-h6: 1.0625rem;
        --fs-lead: clamp(1.125rem, 1.5vw, 1.375rem);
        --fs-body: 1rem;
        --fs-small: 0.875rem;
        --fs-xs: 0.75rem;
        /* ---- Spacing scale ---- */
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 12px;
        --space-4: 16px;
        --space-5: 20px;
        --space-6: 24px;
        --space-8: 32px;
        --space-10: 40px;
        --space-12: 48px;
        --space-16: 64px;
        --space-20: 80px;
        --space-24: 96px;
        /* ---- Radius ---- */
        --button-radius: {{ settings.button_radius }}px;
        --image-radius: {{ settings.image_corner_radius }}px;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        --radius-pill: 9999px;
        /* ---- Shadow system ---- */
        --shadow-xs: 0 1px 2px color-mix(in srgb, var(--color-text) 5%, transparent);
        --shadow-sm: 0 2px 8px color-mix(in srgb, var(--color-text) 8%, transparent);
        --shadow-md: 0 8px 24px color-mix(in srgb, var(--color-text) 10%, transparent);
        --shadow-lg: 0 16px 48px color-mix(in srgb, var(--color-text) 12%, transparent);
        --shadow-xl: 0 28px 64px -20px color-mix(in srgb, var(--color-text) 24%, transparent);
        --shadow-focus: 0 0 0 4px color-mix(in srgb, var(--color-primary) 12%, transparent);
        --shadow-focus-error: 0 0 0 4px color-mix(in srgb, var(--color-error) 10%, transparent);
        /* ---- Motion ---- */
        --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
        --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
        --ease-smooth: cubic-bezier(0.28, 0.11, 0.32, 1);
        --duration-fast: 0.2s;
        --duration-base: 0.3s;
        --duration-md: 0.4s;
        --duration-slow: 0.6s;
        --duration-reveal: 0.9s;
        /* ---- Z-index scale ---- */
        --z-header: 100;
        --z-drawer: 140;
        --z-overlay: 138;
        --z-modal: 160;
        --z-toast: 200;
      }
    </style>

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'anode-v3.css' | asset_url }}">

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>

    {%- if request.page_type == 'product' -%}
      <script src="{{ 'product.js' | asset_url }}" defer></script>
    {%- endif -%}
  </head>

  <body class="template-{{ request.page_type | handle }}">

    <div class="scroll-progress" aria-hidden="true"></div>

    <a class="skip-to-content" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.search_type == 'modal' -%}
      {% render 'search-modal' %}
    {%- endif -%}

    <div class="drawer-overlay" data-drawer-overlay hidden></div>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-selection-message">{{ 'accessibility.selection_help' | t }}</li>
      <li id="a11y-slideshow-info">{{ 'accessibility.slideshow_info' | t }}</li>
    </ul>

    <script>
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
      window.cartStrings = {
        error: {{ 'cart.cart_error' | t | json }},
        quantityError: {{ 'cart.cart_quantity_error' | t: quantity: '[quantity]' | json }}
      };
      window.shopCurrency = {{ cart.currency.iso_code | json }};
    </script>
  </body>
</html>
