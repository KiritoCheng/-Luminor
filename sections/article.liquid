<article class="section">
  <div class="page-width">
    <div class="article__hero">
      <p class="eyebrow">{{ article.published_at | date: '%B %-d, %Y' }}</p>
      <h1 class="collection-hero__title">{{ article.title | escape }}</h1>
      {%- if article.image -%}
        {{ article.image | image_url: width: 1600 | image_tag:
          loading: 'eager',
          sizes: '(max-width: 990px) 100vw, 1024px',
          widths: '500, 750, 1100, 1500',
          class: 'article__image',
          alt: article.title | escape }}
      {%- endif -%}
    </div>
    <div class="article__content rte">
      {{ article.content }}
    </div>
    <div style="text-align:center;margin-top:48px;">
      <a href="{{ blog.url }}" class="link-arrow">{{ 'blogs.article.back_to_blog' | t: blog: blog.title }}</a>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section"
}
{% endschema %}
