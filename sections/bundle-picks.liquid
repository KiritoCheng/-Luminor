{%- comment -%}
  ============================================================================
  Complete the setup  —  Anode Theme
  ----------------------------------------------------------------------------
  Accessory retail lives or dies on attach rate. This section lets the
  customer tick the parts they want and add all of them in one request —
  no page reloads, no separate trips through the cart.

  Data source, in priority order:
    1. product.metafields.anode.bundle_products   (type: list.product_reference)
    2. Section blocks (product pickers)           — for hand-curated sets
    3. section.settings.collection                — a whole collection as the pool

  The running total is computed from the live variant prices, so a
  "save $X" figure is never invented — it is only shown when the merchant
  sets a real compare-at price on the bundle.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign picks = product.metafields.anode.bundle_products.value
  assign items = ''
  assign source = 'none'
  assign block_has_product = false

  for block in section.blocks
    if block.settings.product != blank
      assign block_has_product = true
      break
    endif
  endfor

  if picks and picks.size > 0
    assign items = picks
    assign source = 'metafield'
  elsif block_has_product
    assign source = 'blocks'
  elsif section.settings.collection != blank and section.settings.collection.products.size > 0
    assign items = section.settings.collection.products
    assign source = 'collection'
  endif
-%}

{%- if source != 'none' -%}
<section class="section bundle reveal{% if section.settings.color_scheme == 'alt' %} bg-alt{% endif %}"
  data-bundle>
  <div class="page-width">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="bundle__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="lead color-muted">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- capture bundle_form_id -%}BundleForm-{{ section.id }}{%- endcapture -%}

    <form id="{{ bundle_form_id }}" class="bundle__form" data-bundle-form
      data-currency="{{ cart.currency.iso_code }}"
      data-total-label="{{ 'sections.bundle.total' | t }}"
      data-selected-label="{{ 'sections.bundle.selected_count' | t }}"
      data-error-label="{{ 'sections.bundle.error' | t }}"
      data-empty-label="{{ 'sections.bundle.pick_one' | t }}">
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">

      <div class="bundle__grid" role="list">

        {%- if source == 'blocks' -%}
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            {%- if p and p.available -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              <label class="bundle__item" role="listitem" {{ block.shopify_attributes }}>
                <input type="checkbox" class="bundle__check" name="items[]"
                  value="{{ v.id }}"
                  data-price="{{ v.price | money_without_currency | strip_html }}"
                  data-title="{{ p.title | escape }}"
                  {% if block.settings.preselected %}checked{% endif %}>
                <span class="bundle__media media media--square">
                  {%- if p.featured_image -%}
                    {{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: p.featured_image.alt | default: p.title | escape }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'bundle__placeholder' }}
                  {%- endif -%}
                </span>
                <span class="bundle__body">
                  <span class="bundle__title">{{ p.title | escape }}</span>
                  {%- if block.settings.note != blank -%}
                    <span class="bundle__note">{{ block.settings.note | escape }}</span>
                  {%- endif -%}
                  <span class="bundle__price">
                    {{ v.price | money }}
                    {%- if v.compare_at_price > v.price -%}
                      <s class="bundle__was">{{ v.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}

        {%- else -%}
          {%- for p in items limit: section.settings.products_to_show -%}
            {%- if p and p.available -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              <label class="bundle__item" role="listitem">
                <input type="checkbox" class="bundle__check" name="items[]"
                  value="{{ v.id }}"
                  data-price="{{ v.price | money_without_currency | strip_html }}"
                  data-title="{{ p.title | escape }}">
                <span class="bundle__media media media--square">
                  {%- if p.featured_image -%}
                    {{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: p.featured_image.alt | default: p.title | escape }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'bundle__placeholder' }}
                  {%- endif -%}
                </span>
                <span class="bundle__body">
                  <span class="bundle__title">{{ p.title | escape }}</span>
                  <span class="bundle__price">
                    {{ v.price | money }}
                    {%- if v.compare_at_price > v.price -%}
                      <s class="bundle__was">{{ v.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

      </div>

      <div class="bundle__bar">
        <div class="bundle__summary">
          <span class="bundle__count" data-bundle-count>0</span>
          <span class="bundle__total">
            {{ 'sections.bundle.total' | t }}
            <strong data-bundle-total>—</strong>
          </span>
        </div>
        <button type="submit" class="btn btn--primary" data-bundle-submit>
          {{ section.settings.button_label | default: 'Add selected to cart' | escape }}
        </button>
      </div>

      <p class="bundle__status" data-bundle-status role="status" aria-live="polite"></p>
    </form>

  </div>
</section>
{%- endif -%}

{% schema %}{
  "name": "Complete the setup",
  "tag": "section",
  "class": "section-bundle",
  "settings": [
    { "type": "paragraph", "content": "Uses product.metafields.anode.bundle_products when set, otherwise the products picked below. Customers tick items and add them all in one request." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the setup" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "The parts people usually buy together. Add them in one go." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add selected to cart" },
    { "type": "collection", "id": "collection", "label": "Fallback collection" },
    { "type": "range", "id": "products_to_show", "label": "Items shown", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [
        { "value": "scheme_1", "label": "Default" },
        { "value": "alt", "label": "Alternate" }
      ],
      "default": "alt"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bundle item",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "note", "label": "Note", "default": "Pairs with the item above" },
        { "type": "checkbox", "id": "preselected", "label": "Ticked by default", "default": false }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Complete the setup",
      "blocks": [
        { "type": "item", "settings": { "note": "Protects the screen", "preselected": true } },
        { "type": "item", "settings": { "note": "15W magnetic charging" } },
        { "type": "item", "settings": { "note": "Cable that carries the full wattage" } }
      ]
    }
  ]
}{% endschema %}
