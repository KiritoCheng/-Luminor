<section class="section collection-list reveal{% if section.settings.color_scheme == 'alt' %} bg-alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="section-heading__title">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="collection-list__grid stagger" style="grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr)">
      {%- liquid
        assign blocks_have_collections = false
        for block in section.blocks
          assign test_coll = collections[block.settings.collection]
          if test_coll != blank
            assign blocks_have_collections = true
            break
          endif
        endfor
      -%}

      {%- if section.blocks.size > 0 and blocks_have_collections -%}
        {%- for block in section.blocks -%}
          {%- assign coll = collections[block.settings.collection] -%}
          {%- if coll != blank -%}
            <a href="{{ coll.url }}" class="collection-card" {{ block.shopify_attributes }}>
              {%- if coll.featured_image -%}
                {{ coll.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: coll.title | escape }}
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'collection-card__placeholder' }}
              {%- endif -%}
              <div class="collection-card__overlay">
                <h3 class="collection-card__title">{{ coll.title | escape }}</h3>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign counter = 0 -%}
        {%- for coll in collections -%}
          {%- assign counter = counter | plus: 1 -%}
          {%- if counter > 3 -%}{%- break -%}{%- endif -%}
          <a href="{{ coll.url }}" class="collection-card">
            {%- if coll.featured_image -%}
              {{ coll.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: coll.title | escape }}
            {%- else -%}
              {{ 'collection-' | append: counter | placeholder_svg_tag: 'collection-card__placeholder' }}
            {%- endif -%}
            <div class="collection-card__overlay">
              <h3 class="collection-card__title">{{ coll.title | escape }}</h3>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alt background" } ], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [ { "type": "collection", "id": "collection", "label": "Collection" } ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ]
    }
  ]
}
{% endschema %}
