{%- liquid
  assign columns = section.settings.columns_desktop | default: 4
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.min_value.value != blank or filter.max_value.value != blank
      assign active_filter_count = active_filter_count | plus: 1
    endif
  endfor
-%}

<section class="section anode-collection">
  <div class="page-width">
    {%- if section.settings.show_collection_title -%}
      <header class="anode-collection__hero">
        <div class="anode-collection__eyebrow">
          <span>02</span><i aria-hidden="true"></i><span>Collection / Explore</span>
        </div>
        <div class="anode-collection__hero-grid">
          <div>
            <h1 class="anode-collection__title">{{ collection.title | escape }}</h1>
          </div>
          <div class="anode-collection__hero-side">
            {%- if collection.description != blank -%}<div class="anode-collection__description rte">{{ collection.description }}</div>{%- endif -%}
            <p class="anode-collection__meta">{{ collection.products_count }} {{ 'sections.collection_template.products' | t | default: 'objects' }}</p>
          </div>
        </div>
      </header>
    {%- endif -%}

    <div class="anode-collection__layout">
      <aside class="facets anode-collection__facets" data-facets>
        <div class="anode-collection__facet-heading">
          <span class="anode-collection__facet-index">FILTER</span>
          <span class="anode-collection__facet-count">{{ active_filter_count }}</span>
          <button type="button" class="facets__close" data-facets-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
        </div>
        <form id="FacetForm">
          {%- for filter in collection.filters -%}
            <details class="facets__group" {% if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank %}open{% endif %}>
              <summary><span>{{ filter.label | escape }}</span><span aria-hidden="true">+</span></summary>
              <div class="facets__options">
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="anode-collection__price-fields">
                      <label><span class="visually-hidden">Minimum price</span><input type="number" name="{{ filter.min_value_param }}" value="{{ filter.min_value.value }}" placeholder="Min"></label>
                      <span aria-hidden="true">—</span>
                      <label><span class="visually-hidden">Maximum price</span><input type="number" name="{{ filter.max_value_param }}" value="{{ filter.max_value.value }}" placeholder="Max"></label>
                    </div>
                  {%- else -%}
                    {%- for value in filter.values -%}
                      <label class="checkbox anode-collection__filter-value">
                        <input type="checkbox" name="{{ value.param }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span>{{ value.label | escape }}</span><small>{{ value.count }}</small>
                      </label>
                    {%- endfor -%}
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
          {%- if active_filter_count > 0 -%}<a class="anode-collection__clear" href="{{ collection.url }}">Clear all filters</a>{%- endif -%}
          <noscript><button type="submit" class="button button--primary button--full">{{ 'sections.collection_template.apply' | t | default: 'Apply filters' }}</button></noscript>
        </form>
      </aside>

      <main class="anode-collection__results">
        <div class="anode-collection__toolbar">
          <div class="anode-collection__toolbar-left">
            <button type="button" class="anode-collection__filters-btn" data-facets-open aria-expanded="false">
              <span class="anode-collection__toolbar-number">{{ active_filter_count | prepend: '0' | slice: -2, 2 }}</span>
              <span>{{ 'sections.collection_template.filter' | t | default: 'Filter' }}</span>
            </button>
            <span class="anode-collection__result-count">{{ collection.products_count }} {{ 'sections.collection_template.product_count' | t: count: collection.products_count | default: 'products' }}</span>
          </div>
          <form id="SortForm" class="anode-collection__sort" method="get">
            <label for="CollectionSort">{{ 'sections.collection_template.sort_by' | t | default: 'Sort' }}</label>
            <select id="CollectionSort" name="sort_by" aria-label="{{ 'sections.collection_template.sort_by' | t }}">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </form>
        </div>

        <div id="ProductGrid" data-cart-page-items>
          {%- paginate collection.products by section.settings.products_per_page -%}
            <div class="product-grid anode-collection__grid" style="--cols: {{ columns }}">
              {%- for product in collection.products -%}
                <div class="reveal" style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 70 }}ms">
                  {% render 'product-card', product: product %}
                </div>
              {%- else -%}
                <div class="anode-collection__empty">
                  <span class="anode-collection__empty-index">/ 00</span>
                  <h2>{{ 'sections.collection_template.no_matches' | t | default: 'Nothing matched your filters.' }}</h2>
                  <a class="link-arrow" href="{{ collection.url }}">Reset collection <span aria-hidden="true">↗</span></a>
                </div>
              {%- endfor -%}
            </div>
            {% render 'pagination', paginate: paginate %}
          {%- endpaginate -%}
        </div>
      </main>
    </div>
  </div>
</section>

<script>
  (function () {
    var facetForm = document.getElementById('FacetForm');
    if (facetForm) {
      facetForm.addEventListener('change', function () { facetForm.submit(); });
    }
    var sortForm = document.getElementById('SortForm');
    var sortSelect = document.getElementById('CollectionSort');
    if (sortForm && sortSelect) {
      sortForm.addEventListener('change', function () {
        var params = new URLSearchParams(window.location.search);
        params.set('sort_by', sortSelect.value);
        window.location.search = params.toString();
      });
    }
    document.querySelectorAll('[data-facets-open]').forEach(function (button) {
      button.addEventListener('click', function () { button.setAttribute('aria-expanded', 'true'); });
    });
  })();
</script>

<style>
  .anode-collection { --anode-collection-line: color-mix(in srgb, var(--color-text, #1b1b20) 13%, transparent); }
  .anode-collection__hero { padding-bottom: clamp(44px, 7vw, 86px); }
  .anode-collection__eyebrow { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; margin-bottom: 28px; color: var(--color-text-muted, #71717a); font-size: .6875rem; letter-spacing: .14em; text-transform: uppercase; }
  .anode-collection__eyebrow span:first-child { color: var(--color-text, #1b1b20); font-weight: 700; }
  .anode-collection__eyebrow i { height: 1px; background: var(--anode-collection-line); }
  .anode-collection__hero-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(260px, .55fr); gap: clamp(35px, 8vw, 130px); align-items: end; }
  .anode-collection__title { margin: 0; font-size: clamp(3.2rem, 9vw, 8rem); line-height: .88; letter-spacing: -.065em; font-weight: 600; text-wrap: balance; }
  .anode-collection__hero-side { padding-bottom: 7px; border-left: 1px solid var(--anode-collection-line); padding-left: 22px; }
  .anode-collection__description { max-width: 460px; font-size: .9375rem; line-height: 1.7; }
  .anode-collection__meta { margin: 25px 0 0; font-size: .625rem; letter-spacing: .13em; text-transform: uppercase; color: var(--color-text-muted, #71717a); }
  .anode-collection__layout { display: grid; grid-template-columns: minmax(190px, 220px) minmax(0, 1fr); gap: clamp(24px, 4vw, 60px); align-items: start; border-top: 1px solid var(--anode-collection-line); }
  .anode-collection__facets { position: sticky; top: 24px; padding-top: 19px; }
  .anode-collection__facet-heading { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; margin-bottom: 17px; font-size: .625rem; letter-spacing: .14em; text-transform: uppercase; }
  .anode-collection__facet-index { font-weight: 700; }
  .anode-collection__facet-count { min-width: 20px; height: 20px; padding: 0 5px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--anode-collection-line); font-size: .5625rem; }
  .anode-collection__facet-heading .facets__close { display: none; }
  .anode-collection .facets__group { border-top: 1px solid var(--anode-collection-line); padding: 0; }
  .anode-collection .facets__group:last-of-type { border-bottom: 1px solid var(--anode-collection-line); }
  .anode-collection .facets__group summary { min-height: 50px; padding: 12px 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; list-style: none; cursor: pointer; font-size: .6875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .anode-collection .facets__group summary::-webkit-details-marker { display: none; }
  .anode-collection .facets__group summary span:last-child { font-size: 1rem; font-weight: 400; transition: transform .2s ease; }
  .anode-collection .facets__group[open] summary span:last-child { transform: rotate(45deg); }
  .anode-collection .facets__options { padding: 0 0 14px; }
  .anode-collection__filter-value { min-height: 36px; display: grid; grid-template-columns: 16px 1fr auto; align-items: center; gap: 8px; font-size: .75rem; cursor: pointer; }
  .anode-collection__filter-value small { color: var(--color-text-muted, #71717a); font-size: .625rem; }
  .anode-collection__price-fields { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 6px; }
  .anode-collection__price-fields input { width: 100%; min-height: 38px; padding: 8px; border: 1px solid var(--anode-collection-line); border-radius: 0; background: transparent; font: inherit; font-size: .6875rem; }
  .anode-collection__clear { display: inline-block; margin-top: 15px; font-size: .625rem; letter-spacing: .08em; text-transform: uppercase; text-underline-offset: 4px; }
  .anode-collection__results { min-width: 0; }
  .anode-collection__toolbar { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--anode-collection-line); }
  .anode-collection__toolbar-left { display: flex; align-items: center; gap: 18px; }
  .anode-collection__filters-btn { display: none; }
  .anode-collection__result-count { color: var(--color-text-muted, #71717a); font-size: .625rem; letter-spacing: .1em; text-transform: uppercase; }
  .anode-collection__sort { display: flex; align-items: center; gap: 10px; }
  .anode-collection__sort label { color: var(--color-text-muted, #71717a); font-size: .625rem; letter-spacing: .1em; text-transform: uppercase; }
  .anode-collection__sort select { min-height: 40px; padding: 6px 28px 6px 0; border: 0; border-bottom: 1px solid var(--anode-collection-line); border-radius: 0; background: transparent; color: inherit; font: inherit; font-size: .6875rem; cursor: pointer; }
  .anode-collection__grid { padding-top: 26px; gap: clamp(17px, 2.2vw, 30px); }
  .anode-collection__empty { grid-column: 1 / -1; min-height: 330px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; border-top: 1px solid var(--anode-collection-line); border-bottom: 1px solid var(--anode-collection-line); }
  .anode-collection__empty-index { color: var(--color-primary, #4f46e5); font-size: .625rem; font-weight: 700; letter-spacing: .12em; }
  .anode-collection__empty h2 { max-width: 560px; margin: 12px 0 24px; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1; letter-spacing: -.04em; font-weight: 600; }
  .anode-collection .pagination { margin-top: 44px; }
  @media (max-width: 989px) {
    .anode-collection__hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(220px, .9fr); }
    .anode-collection__layout { grid-template-columns: 180px minmax(0, 1fr); gap: 24px; }
  }
  @media (max-width: 749px) {
    .anode-collection__hero { padding-bottom: 42px; }
    .anode-collection__hero-grid { display: block; }
    .anode-collection__title { font-size: clamp(3.3rem, 18vw, 6rem); }
    .anode-collection__hero-side { margin-top: 28px; padding: 18px 0 0; border-left: 0; border-top: 1px solid var(--anode-collection-line); }
    .anode-collection__layout { display: block; border-top: 0; }
    .anode-collection__facets { position: fixed; inset: 0; z-index: 50; width: min(88vw, 380px); padding: 22px; background: var(--color-background, #fff); box-shadow: 8px 0 30px rgba(0,0,0,.12); transform: translateX(-105%); transition: transform .25s ease; overflow-y: auto; }
    .anode-collection__facets.is-open { transform: translateX(0); }
    .anode-collection__facet-heading .facets__close { display: inline-flex; grid-column: 2; grid-row: 1; }
    .anode-collection__toolbar { min-height: 62px; }
    .anode-collection__filters-btn { display: inline-flex; align-items: center; gap: 9px; min-height: 40px; padding: 8px 12px; border: 1px solid var(--anode-collection-line); border-radius: 0; background: transparent; color: inherit; font: inherit; font-size: .625rem; letter-spacing: .08em; text-transform: uppercase; }
    .anode-collection__toolbar-number { font-variant-numeric: tabular-nums; color: var(--color-primary, #4f46e5); }
    .anode-collection__result-count { display: none; }
    .anode-collection__sort label { display: none; }
    .anode-collection__sort select { font-size: .625rem; }
    .anode-collection__grid { padding-top: 17px; gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .anode-collection__facets,
    .anode-collection .facets__group summary span:last-child { transition: none; }
  }
</style>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_collection_title", "label": "Show collection title", "default": true },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 }
  ]
}
{% endschema %}
