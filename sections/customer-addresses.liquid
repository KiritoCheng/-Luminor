<section class="section">
  <div class="page-width">
    <div class="customer">
      <h1 class="customer__title">{{ 'customer.addresses.title' | t }}</h1>

      <div class="addresses__grid">
        {%- for address in customer.addresses -%}
          <div class="cart-summary" style="background:var(--color-bg-alt);">
            <p><strong>{{ address.name }}</strong>{% if address == customer.default_address %} <span class="badge">{{ 'customer.addresses.default' | t }}</span>{% endif %}</p>
            <p class="color-muted" style="font-size:0.9375rem;margin-top:8px;">{{ address | format_address }}</p>
            <div style="margin-top:14px;display:flex;gap:10px;">
              <button class="button button--tertiary" data-edit-address="{{ address.id }}">{{ 'customer.addresses.edit' | t }}</button>
              {{ 'customer.addresses.delete' | t | delete_customer_address_link: address.id, class: 'button button--tertiary' }}
            </div>
          </div>
        {%- endfor -%}

        <div class="cart-summary" style="background:var(--color-bg);border:1px dashed var(--color-border);text-align:center;">
          <p>{{ 'customer.addresses.add_new' | t }}</p>
          <button class="button button--secondary" data-new-address>{{ 'customer.addresses.add' | t }}</button>
        </div>
      </div>

      {%- form 'customer_address', customer.new_address, class: 'customer__form', id: 'NewAddressForm', style: 'display:none;margin-top:24px;' -%}
        <h2 style="font-size:1.125rem;margin-bottom:12px;">{{ 'customer.addresses.add' | t }}</h2>
        <div><label class="field-label">{{ 'customer.addresses.first_name' | t }}</label><input type="text" name="address[first_name]"></div>
        <div><label class="field-label">{{ 'customer.addresses.last_name' | t }}</label><input type="text" name="address[last_name]"></div>
        <div><label class="field-label">{{ 'customer.addresses.address1' | t }}</label><input type="text" name="address[address1]"></div>
        <div><label class="field-label">{{ 'customer.addresses.city' | t }}</label><input type="text" name="address[city]"></div>
        <div><label class="field-label">{{ 'customer.addresses.country' | t }}</label><select name="address[country]">{{ all_country_option_tags }}</select></div>
        <div><label class="field-label">{{ 'customer.addresses.zip' | t }}</label><input type="text" name="address[zip]"></div>
        <div><label class="field-label">{{ 'customer.addresses.phone' | t }}</label><input type="tel" name="address[phone]"></div>
        <button type="submit" class="button button--primary button--full">{{ 'customer.addresses.save' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var newBtn = document.querySelector('[data-new-address]');
    var form = document.getElementById('NewAddressForm');
    if (newBtn && form) newBtn.addEventListener('click', function () { form.style.display = form.style.display === 'none' ? 'block' : 'none'; });
  })();
</script>

{% schema %}
{
  "name": "Addresses",
  "tag": "section"
}
{% endschema %}
