<section class="section">
  <div class="page-width">
    <div class="customer">
      <h1 class="customer__title">{{ 'customer.register_page.title' | t }}</h1>

      {%- form 'create_customer', class: 'customer__form' -%}
        {%- if form.errors -%}
          <p style="color:var(--color-text);background:var(--color-bg-alt);padding:12px;border-radius:12px;margin-bottom:16px;">
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <div>
          <label for="FirstName" class="field-label">{{ 'customer.register_page.first_name' | t }}</label>
          <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
        </div>
        <div>
          <label for="LastName" class="field-label">{{ 'customer.register_page.last_name' | t }}</label>
          <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
        </div>
        <div>
          <label for="RegEmail" class="field-label">{{ 'customer.register_page.email' | t }}</label>
          <input type="email" name="customer[email]" id="RegEmail" autocomplete="email" required>
        </div>
        <div>
          <label for="RegPassword" class="field-label">{{ 'customer.register_page.password' | t }}</label>
          <input type="password" name="customer[password]" id="RegPassword" autocomplete="new-password" required>
        </div>

        <button type="submit" class="button button--primary button--full button--lg">{{ 'customer.register_page.submit' | t }}</button>
        <div class="customer__actions">
          <a href="{{ routes.account_login_url }}">{{ 'customer.register_page.have_account' | t }}</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Register",
  "tag": "section"
}
{% endschema %}
