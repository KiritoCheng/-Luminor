{%- comment -%}
  Featured Blog — grid of blog articles.
{%- endcomment -%}
<section class="section featured-blog reveal">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="featured-blog__header">
        <h2 class="featured-blog__title">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="featured-blog__grid stagger">
      {%- assign blog = blogs[section.settings.blog] | default: blogs.news -%}
      {%- if blog and blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: section.settings.posts_to_show -%}
          <a href="{{ article.url }}" class="featured-blog__card">
            {%- if article.image -%}
              <div class="featured-blog__image">
                {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title | escape }}
              </div>
            {%- endif -%}
            <div class="featured-blog__info">
              {%- if article.tags.size > 0 -%}
                <p class="featured-blog__tag">{{ article.tags.first | escape }}</p>
              {%- endif -%}
              <h3 class="featured-blog__article-title">{{ article.title | escape }}</h3>
              <p class="featured-blog__excerpt">{{ article.content | strip_html | truncatewords: 20 | escape }}</p>
              <p class="featured-blog__date">{{ article.published_at | date: '%b %d, %Y' }}</p>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="featured-blog__card featured-blog__card--placeholder">
            <div class="featured-blog__image featured-blog__image--placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'featured-blog__placeholder' }}
            </div>
            <div class="featured-blog__info">
              <p class="featured-blog__tag">Design</p>
              <h3 class="featured-blog__article-title">Coming soon</h3>
              <p class="featured-blog__excerpt">Stay tuned for our latest stories and insights.</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
<style>
.featured-blog__header { margin-bottom: 40px; }
.featured-blog__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
.featured-blog__card {
  text-decoration: none;
  color: inherit;
  display: block;
}
.featured-blog__image {
  border-radius: var(--image-radius);
  overflow: hidden;
  aspect-ratio: 4 / 3;
  margin-bottom: 16px;
}
.featured-blog__image img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.6s var(--ease-out-expo);
}
.featured-blog__card:hover .featured-blog__image img { transform: scale(1.05); }
.featured-blog__tag {
  font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.08em; color: var(--color-primary); margin-bottom: 8px;
}
.featured-blog__article-title {
  font-size: 1.125rem; font-weight: 600; letter-spacing: -0.02em;
  margin-bottom: 8px; line-height: 1.3;
}
.featured-blog__excerpt {
  font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.5;
  margin-bottom: 8px;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.featured-blog__date { font-size: 0.75rem; color: var(--color-text-muted); }
@media (max-width: 749px) {
  .featured-blog__grid { grid-template-columns: 1fr; gap: 24px; }
}
@media (min-width: 750px) and (max-width: 990px) {
  .featured-blog__grid { grid-template-columns: 1fr 1fr; }
}
</style>
{% schema %}
{
  "name": "Featured blog",
  "tag": "section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "title", "label": "Title", "default": "Latest articles" },
    { "type": "range", "id": "posts_to_show", "min": 3, "max": 9, "step": 3, "label": "Posts to show", "default": 6 }
  ],
  "presets": [{ "name": "Featured blog" }]
}
{% endschema %}
