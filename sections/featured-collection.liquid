{%- liquid
  assign collection = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show | default: 5
  assign columns_desktop = section.settings.columns_desktop | default: 4

  # The bento feature card spans 2 columns and 2 rows, so the grid only closes
  # without a hole when (count + 3) is divisible by the column count, with a
  # floor of 2*columns - 3. Verified against real CSS grid placement for 2–5
  # columns: any other count leaves a gap at the end of the last row that reads
  # as a missing product. Fall back to a uniform grid instead of shipping one.
  assign bento_min = columns_desktop | times: 2 | minus: 3
  assign bento_remainder = products_to_show | plus: 3 | modulo: columns_desktop
  assign bento_active = false
  if section.settings.bento and bento_remainder == 0 and products_to_show >= bento_min
    assign bento_active = true
  endif

  # Placeholder state has no data to honour, so round the count up to a full row
  # rather than preview a ragged edge to a merchant who has not configured it yet.
  assign demo_count = products_to_show
  unless bento_active
    assign demo_remainder = products_to_show | modulo: columns_desktop
    if demo_remainder != 0
      assign demo_count = products_to_show | minus: demo_remainder | plus: columns_desktop
    endif
  endunless
-%}

<section class="section featured-collection reveal">
  <div class="page-width">
    <div class="featured-collection__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="featured-collection__title">{{ section.settings.title | escape }}</h2>
      </div>
      {%- if section.settings.view_all_link != blank and collection != blank -%}
        <a href="{{ collection.url }}" class="link-arrow">{{ section.settings.view_all_label | default: 'View all' | escape }}</a>
      {%- endif -%}
    </div>

    {%- assign grid_class = 'featured-collection__grid product-grid stagger' -%}
    {%- if bento_active -%}
      {%- assign grid_class = grid_class | append: ' featured-collection__grid--bento' -%}
    {%- endif -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="{{ grid_class }}" style="--cols: {{ columns_desktop }}">
        {%- for product in collection.products limit: products_to_show -%}
          <div class="reveal {% if forloop.first and bento_active %}featured-collection__item--feature{% endif %}">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="{{ grid_class }}" style="--cols: {{ columns_desktop }}">
        {%- for i in (1..demo_count) -%}
          <div class="reveal {% if forloop.first and bento_active %}featured-collection__item--feature{% endif %}">
            <div class="product-card">
              <div class="product-card__media">
                {%- comment -%}
                  Shopify only ships product-1 through product-6. Indexing past
                  that raises "Unknown SVG placeholder", so wrap the index into 1-6.
                {%- endcomment -%}
                {{ forloop.index0 | modulo: 6 | plus: 1 | prepend: 'product-' | placeholder_svg_tag: 'product-card__placeholder' }}
              </div>
              <h3 class="product-card__title">{{ 'sections.featured_collection.example_title' | t }}</h3>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Featured products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 5,
      "info": "With the bento layout on, the grid closes cleanly when this number plus 3 divides by the column count — for example 5 or 9 at 4 columns. Other values switch the section to an even grid."
    },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "checkbox",
      "id": "bento",
      "label": "Bento layout (first product spans 2x2)",
      "default": true,
      "info": "Applies only when the product count fills the grid. Otherwise the section renders an even grid so no cell is left empty."
    },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
