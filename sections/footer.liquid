{%- comment -%}
  Footer — multi-column footer with newsletter, navigation links, and payment.
  Link columns use self-contained link blocks so the demo works without menu setup.
{%- endcomment -%}
<footer class="footer" data-footer>
  <div class="footer__newsletter-bar">
    <div class="page-width">
      <div class="footer__newsletter-inner">
        <div class="footer__newsletter-text">
          <h3 class="footer__newsletter-title">
            {{ section.settings.newsletter_title | default: 'Join the Luminor circle' | escape }}
          </h3>
          <p class="footer__newsletter-sub">
            {{
              section.settings.newsletter_text
              | default: 'Get early access to new drops, exclusive offers, and stories from the studio.'
              | escape
            }}
          </p>
        </div>
        <div class="footer__newsletter-form">
          {%- form 'customer', class: 'footer__newsletter-form-inner' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer__newsletter-field">
              <input
                type="email"
                name="contact[email]"
                placeholder="Enter your email"
                class="footer__newsletter-input"
                aria-label="Email address"
                required
              >
              <button type="submit" class="footer__newsletter-btn">
                {{ section.settings.newsletter_btn | default: 'Subscribe' | escape }}
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="footer__newsletter-success">Thanks for subscribing!</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>

  <div class="footer__main">
    <div class="page-width">
      <div class="footer__cols">
        <div class="footer__col footer__col--brand">
          <a href="{{ routes.root_url }}" class="footer__logo">{{ shop.name }}</a>
          {%- if section.settings.text != blank -%}
            <div class="footer__brand-text rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- assign social_list = 'twitter,facebook,instagram,youtube,tiktok' | split: ',' -%}
          {%- assign show_social = false -%}
          {%- for s in social_list -%}
            {%- assign setting_key = 'social_' | append: s | append: '_link' -%}
            {%- if settings[setting_key] != blank -%}{%- assign show_social = true -%}{%- endif -%}
          {%- endfor -%}
          {%- if show_social -%}
            <div class="footer__social">
              <p class="footer__social-label">Follow us</p>
              <div class="footer__social-icons">
                {%- if settings.social_twitter_link != blank -%}
                  <a href="{{ settings.social_twitter_link }}" aria-label="X / Twitter" rel="noopener" target="_blank">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231 5.447-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z"/>
                    </svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <a href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener" target="_blank">
                    <svg viewBox="0 0 24 24" fill="none">
                      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="7" r="1.2" fill="currentColor"/>
                    </svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_facebook_link != blank -%}
                  <a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener" target="_blank">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/>
                    </svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <a href="{{ settings.social_youtube_link }}" aria-label="YouTube" rel="noopener" target="_blank">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M23.5 6.2a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.51A3.02 3.02 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3.02 3.02 0 0 0 2.12 2.14c1.88.51 9.38.51 9.38.51s7.5 0 9.38-.51a3.02 3.02 0 0 0 2.12-2.14A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/>
                    </svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}
                  <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok" rel="noopener" target="_blank">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.3 0 .6.04.88.13V9.4a6.33 6.33 0 0 0-.88-.06A6.34 6.34 0 0 0 3 15.69a6.34 6.34 0 0 0 6.34 6.34A6.34 6.34 0 0 0 15.68 15.69V9.01a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.86-.44z"/>
                    </svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_column' -%}
              <div class="footer__col" {{ block.shopify_attributes }}>
                <p class="footer__col-title">{{ block.settings.heading | escape }}</p>
                <ul class="footer__col-links">
                  {%- if block.settings.label_1 != blank -%}
                    <li>
                      <a href="{{ block.settings.link_1 | default: '#' }}">{{ block.settings.label_1 | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.label_2 != blank -%}
                    <li>
                      <a href="{{ block.settings.link_2 | default: '#' }}">{{ block.settings.label_2 | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.label_3 != blank -%}
                    <li>
                      <a href="{{ block.settings.link_3 | default: '#' }}">{{ block.settings.label_3 | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.label_4 != blank -%}
                    <li>
                      <a href="{{ block.settings.link_4 | default: '#' }}">{{ block.settings.label_4 | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.label_5 != blank -%}
                    <li>
                      <a href="{{ block.settings.link_5 | default: '#' }}">{{ block.settings.label_5 | escape }}</a>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            {%- when 'contact' -%}
              <div class="footer__col footer__col--contact" {{ block.shopify_attributes }}>
                <p class="footer__col-title">{{ block.settings.heading | escape }}</p>
                <ul class="footer__col-links">
                  {%- if block.settings.email != blank -%}
                    <li>
                      <a href="mailto:{{ block.settings.email }}">{{ block.settings.email | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.phone != blank -%}
                    <li>
                      <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.address != blank -%}
                    <li class="footer__col-address">{{ block.settings.address | escape }}</li>
                  {%- endif -%}
                </ul>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="page-width">
      <div class="footer__bottom-inner">
        <p class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }}
          {{ shop.name }}. All rights reserved.
        </p>
        <div class="footer__bottom-right">
          {%- if section.settings.show_localization -%}
            {% form 'localization', class: 'localization-form' %}
              <div class="localization" data-localization>
                <button
                  type="button"
                  class="localization__trigger"
                  data-localization-trigger
                  aria-expanded="false"
                  aria-controls="localization-panel-{{ section.id }}"
                >
                  <span class="localization__current">
                    {{ localization.country.iso_code }} · {{ localization.currency.iso_code }}
                  </span>
                  <svg class="localization__chevron" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </button>
                <div class="localization__panel" id="localization-panel-{{ section.id }}" role="listbox" data-localization-panel>
                  <div class="localization__group">
                    <p class="localization__group-label">{{ 'sections.footer.country' | t }}</p>
                    {%- for country in localization.available_countries -%}
                      <button
                        type="submit"
                        name="country_code"
                        value="{{ country.iso_code }}"
                        class="localization__option"
                        role="option"
                        {% if country.iso_code == localization.country.iso_code %}aria-selected="true"{% endif %}
                      >
                        <span>{{ country.name }}</span>
                        {%- if country.iso_code == localization.country.iso_code -%}
                          <span class="localization__dot" aria-hidden="true"></span>
                        {%- endif -%}
                      </button>
                    {%- endfor -%}
                  </div>
                  <div class="localization__group">
                    <p class="localization__group-label">{{ 'sections.footer.currency' | t }}</p>
                    {%- for currency in localization.available_currencies -%}
                      <button
                        type="submit"
                        name="currency_code"
                        value="{{ currency.iso_code }}"
                        class="localization__option"
                        role="option"
                        {% if currency.iso_code == localization.currency.iso_code %}aria-selected="true"{% endif %}
                      >
                        <span>{{ currency.iso_code }} · {{ currency.symbol }}</span>
                        {%- if currency.iso_code == localization.currency.iso_code -%}
                          <span class="localization__dot" aria-hidden="true"></span>
                        {%- endif -%}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {% endform %}
          {%- endif -%}
          {%- if section.settings.show_payment -%}
            <div class="footer__payment">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter title", "default": "Join the Luminor circle" },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter subtitle",
      "default": "Get early access to new drops, exclusive offers, and stories from the studio."
    },
    { "type": "text", "id": "newsletter_btn", "label": "Button text", "default": "Subscribe" },
    { "type": "header", "content": "Brand" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Brand text",
      "default": "<p>Premium accessories designed for the way you live. Minimalism, elevated.</p>"
    },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_localization", "label": "Show country & currency selector", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "text", "id": "label_1", "label": "Link 1 label", "default": "All products" },
        { "type": "url", "id": "link_1", "label": "Link 1 URL" },
        { "type": "text", "id": "label_2", "label": "Link 2 label", "default": "Audio" },
        { "type": "url", "id": "link_2", "label": "Link 2 URL" },
        { "type": "text", "id": "label_3", "label": "Link 3 label", "default": "Desk" },
        { "type": "url", "id": "link_3", "label": "Link 3 URL" },
        { "type": "text", "id": "label_4", "label": "Link 4 label", "default": "Everyday" },
        { "type": "url", "id": "link_4", "label": "Link 4 URL" },
        { "type": "text", "id": "label_5", "label": "Link 5 label" },
        { "type": "url", "id": "link_5", "label": "Link 5 URL" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
        { "type": "text", "id": "email", "label": "Email", "default": "hello@luminor.com" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "textarea", "id": "address", "label": "Address" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "heading": "Shop",
            "label_1": "All products",
            "link_1": "/collections/all",
            "label_2": "Audio",
            "link_2": "/collections/all",
            "label_3": "Desk",
            "link_3": "/collections/all",
            "label_4": "Everyday",
            "link_4": "/collections/all"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Support",
            "label_1": "FAQs",
            "link_1": "/pages/faq",
            "label_2": "Shipping & Returns",
            "link_2": "/pages/shipping-returns",
            "label_3": "Warranty",
            "link_3": "/pages/warranty",
            "label_4": "Track Order",
            "link_4": "/pages/track-order"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Company",
            "label_1": "Our Story",
            "link_1": "/pages/about",
            "label_2": "Contact Us",
            "link_2": "/pages/contact",
            "label_3": "Our Blog",
            "link_3": "/pages/about"
          }
        },
        {
          "type": "contact",
          "settings": {
            "heading": "Contact",
            "email": "hello@luminor.com"
          }
        }
      ]
    }
  ]
}
{% endschema %}
