      "id": "autorotate_speed",
      "min": 3, "max": 12, "step": 1, "unit": "s",
      "label": "Change slides every",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#F6F6F8"
        },
        {
          "type": "header",
          "content": "Overlay"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show overlay",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "override_overlay",
          "label": "Customize overlay per slide",
          "default": false
        },
        {
          "type": "color",
          "id": "slide_overlay_color",
          "label": "Overlay tint (override)",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "slide_overlay_strength",
          "min": 0, "max": 100, "step": 5, "unit": "%",
          "label": "Overlay darkness (override)",
          "default": 55
        },
        {
          "type": "checkbox",
          "id": "show_art",
          "label": "Show art overlay (color orbs)",
          "default": true
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "New"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Premium gear. Thoughtfully curated."
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Everyday essentials and curated accessories, built to pair beautifully with what you already love."
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Subtitle color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "eyebrow_color",
          "label": "Eyebrow color",
          "default": "#A78BFA"
        },
        {
          "type": "color",
          "id": "meta_index_color",
          "label": "Slide index & scroll color",
          "default": "#FFFFFFB8"
        },
        {
          "type": "color",
          "id": "meta_line_color",
          "label": "Meta divider line color",
          "default": "#FFFFFF73"
        },
        {
          "type": "color",
          "id": "link_color",
          "label": "Secondary link color",
          "default": "#FFFFFF"
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary button label",
          "default": "Shop the collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary link label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary link link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero / Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "New",
            "heading": "Premium gear. Thoughtfully curated.",
            "subheading": "Everyday essentials and curated accessories, built to pair beautifully with what you already love.",
            "heading_color": "#FFFFFF",
            "subheading_color": "#FFFFFF",
            "eyebrow_color": "#A78BFA",
            "meta_index_color": "#FFFFFFB8",
            "meta_line_color": "#FFFFFF73",
            "link_color": "#FFFFFF",
            "bg_color": "#F6F6F8",
            "show_overlay": true,
            "show_art": true,
            "override_overlay": false,
            "button_label": "Shop the collection",
            "button_link": "/collections/all",
            "button_label_2": "Learn more",
            "button_link_2": "/pages/about"
          }
        }
      ]
    }
  ]
}
{% endschema %}
