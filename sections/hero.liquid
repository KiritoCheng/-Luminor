{%- comment -%}
  Hero / Slideshow section
  Supports a single slide or multiple rotating slides.
  Awwwards-grade: editorial split, char-split headline, parallax layers, grain, magnetic CTA.
{%- endcomment -%}
{%- liquid
  assign blocks = section.blocks
  assign first_block = blocks | first
-%}

{%- comment -%} Awwwards-grade artistic placeholder: layered Apple-inspired composition {%- endcomment -%}
{%- capture hero_placeholder_svg -%}
<div class="hero__placeholder-art" aria-hidden="true">
  <div class="hero__art-orb hero__art-orb--1"></div>
  <div class="hero__art-orb hero__art-orb--2"></div>
  <div class="hero__art-orb hero__art-orb--3"></div>
</div>
{%- endcapture -%}

{%- liquid
  # Convert section-level px range values → rem clamp tokens for fluid typography
  assign h_mob  = section.settings.heading_mobile  | default: 40 | times: 0.0625
  assign h_dsk  = section.settings.heading_desktop | default: 72 | times: 0.0625
  assign s_mob  = section.settings.sub_mobile      | default: 16 | times: 0.0625
  assign s_dsk  = section.settings.sub_desktop     | default: 20 | times: 0.0625
  assign e_mob  = section.settings.eyebrow_mobile  | default: 11 | times: 0.0625
  assign e_dsk  = section.settings.eyebrow_desktop | default: 13 | times: 0.0625
  assign h_wt   = section.settings.heading_weight
  assign h_trk  = section.settings.heading_tracking
  assign h_ld   = section.settings.heading_leading
  assign s_wt   = section.settings.sub_weight
  assign e_wt   = section.settings.eyebrow_weight
  assign o_col  = section.settings.overlay_color   | default: '#000000'
  assign o_str  = section.settings.overlay_strength | default: 55
-%}
<style>
  /* ===== Section-level tokens (fluid sizing + typography) ===== */
  .hero-section {
    --hero-h-fs:          clamp({{ h_mob }}rem, 6vw, {{ h_dsk }}rem);
    --hero-h-weight:      {{ h_wt }};
    --hero-h-tracking:    {{ h_trk }};
    --hero-h-leading:     {{ h_ld }};
    --hero-sub-fs:        clamp({{ s_mob }}rem, 1.6vw, {{ s_dsk }}rem);
    --hero-sub-weight:    {{ s_wt }};
    --hero-eyebrow-fs:    clamp({{ e_mob }}rem, 0.95vw, {{ e_dsk }}rem);
    --hero-eyebrow-weight:{{ e_wt }};
    --hero-overlay-color: {{ o_col }};
    --hero-overlay-strength: {{ o_str }};
  }
  .hero--split {
    text-align: left;
  }
  .hero--split .hero__cta {
    justify-content: flex-start;
  }
  @media screen and (min-width: 750px) {
    .hero--split .hero__content {
      max-width: {{ section.settings.content_max_width }}px;
    }
  }
  /* ===== Eyebrow size token applied through the section variable =====
     (hero__meta-label uses its own size var but also responds to weight/color)  */
  .hero-section .hero__meta-label { font-size: var(--hero-eyebrow-fs); }
</style>

{%- if blocks.size > 0 -%}
  <section class="section--flush hero-section" style="--reveal-delay:0ms">
    {%- if blocks.size > 1 -%}
      <div
        class="slideshow"
        data-slideshow
        data-autoplay="{{ section.settings.autoplay }}"
        data-rotation-speed="{{ section.settings.autorotate_speed }}"
      >
        <div class="slideshow__track" data-slideshow-track>
          {%- for block in blocks -%}
            {%- liquid
              assign style_tokens = ''
              assign s_bg = block.settings.bg_color | default: '#F6F6F8'
              if block.settings.override_overlay
                assign s_oc = block.settings.slide_overlay_color | default: '#000000'
                assign style_tokens = style_tokens | append: '--hero-overlay-color:' | append: s_oc | append: ';'
                assign s_os = block.settings.slide_overlay_strength | default: 55
                assign style_tokens = style_tokens | append: '--hero-overlay-strength:' | append: s_os | append: ';'
              endif
              assign s_hc = block.settings.heading_color | default: '#FFFFFF'
              assign style_tokens = style_tokens | append: '--hero-h-color:' | append: s_hc | append: ';'
              assign s_sc = block.settings.subheading_color | default: '#FFFFFF'
              if s_sc == blank or s_sc == 'rgba(0,0,0,0)'
                assign s_sc = '#FFFFFF'
              endif
              assign style_tokens = style_tokens | append: '--hero-sub-color:' | append: s_sc | append: ';'
              assign s_ec = block.settings.eyebrow_color | default: '#A78BFA'
              assign style_tokens = style_tokens | append: '--hero-eyebrow-color:' | append: s_ec | append: ';'
              assign s_ic = block.settings.meta_index_color | default: 'rgba(255,255,255,0.72)'
              assign style_tokens = style_tokens | append: '--hero-meta-index-color:' | append: s_ic | append: ';'
              assign s_mc = block.settings.meta_line_color | default: 'rgba(255,255,255,0.45)'
              assign style_tokens = style_tokens | append: '--hero-meta-line-color:' | append: s_mc | append: ';'
              assign s_lc = block.settings.link_color | default: '#FFFFFF'
              assign style_tokens = style_tokens | append: '--hero-link-color:' | append: s_lc | append: ';'
            -%}
            <div
              class="slideshow__slide hero hero--{{ section.settings.height }}"
              style="background-color: {{ s_bg }}; {{ style_tokens }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <div class="hero__media" data-parallax="0.2">
                  {{
                    block.settings.image
                    | image_url: width: 2400
                    | image_tag:
                      loading: 'eager',
                      sizes: '100vw',
                      widths: '375, 750, 1100, 1500, 1780, 2000, 2400',
                      alt: block.settings.image.alt
                    | escape
                  }}
                  {%- if block.settings.show_art -%}
                    <div class="hero__media" aria-hidden="true">{{ hero_placeholder_svg }}</div>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="hero__media hero__media--placeholder">
                  {{ hero_placeholder_svg }}
                </div>
              {%- endif -%}
              <div class="hero__grain" aria-hidden="true"></div>
              {%- if block.settings.show_overlay -%}
                <div class="hero__overlay"></div>
              {%- endif -%}
              <div
                class="page-width hero__content"
                data-hero-content
              >
                <div class="hero__meta">
                  <span class="hero__index">
                    {%- if forloop.index < 10 %}0{% endif -%}
                    {{- forloop.index -}}
                  </span>
                  <span class="hero__meta-line"></span>
                  <span class="hero__meta-label">{{ block.settings.eyebrow | default: 'Featured' | escape }}</span>
                </div>
                {%- if block.settings.heading != blank -%}
                  <h1 class="hero__title" data-split-chars>{{ block.settings.heading | escape }}</h1>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p
                    class="hero__subtitle"
                    style="{% if block.settings.subheading_color != blank and block.settings.subheading_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.subheading_color }};{% endif %}"
                  >
                    {{ block.settings.subheading | escape }}
                  </p>
                {%- endif -%}
                {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
                  <div class="hero__cta">
                    {%- if block.settings.button_label != blank -%}
                      <a href="{{ block.settings.button_link }}" class="button button--primary button--lg">
                        {{- block.settings.button_label | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.button_label_2 != blank -%}
                      <a href="{{ block.settings.button_link_2 }}" class="link-arrow">
                        {{ block.settings.button_label_2 | escape }}
                        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_arrows -%}
          <button
            class="slideshow__nav slideshow__nav--prev"
            data-slideshow-prev
            aria-label="{{ 'general.slider.previous' | t }}"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
              <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            class="slideshow__nav slideshow__nav--next"
            data-slideshow-next
            aria-label="{{ 'general.slider.next' | t }}"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
              <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}

        <div class="slideshow__dots">
          {%- for block in blocks -%}
            <button
              class="slideshow__dot {% if forloop.first %}is-active{% endif %}"
              data-slideshow-dot
              aria-label="{{ 'general.slider.go_to' | t: number: forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div
        class="hero hero--{{ section.settings.height }} {% if section.settings.layout == 'split' %}hero--split{% endif %}"
        style="background-color: {{ first_block.settings.bg_color | default: '#F6F6F8' }}"
        {{ first_block.shopify_attributes }}
      >
        {%- if first_block.settings.image != blank -%}
          <div class="hero__media" data-ken-burns data-parallax>
            {{
              first_block.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'eager',
                sizes: '100vw',
                widths: '375, 750, 1100, 1500, 1780, 2000, 2400',
                alt: first_block.settings.image.alt
              | escape
            }}
            {%- if first_block.settings.show_art -%}
              <div class="hero__media" aria-hidden="true">{{ hero_placeholder_svg }}</div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="hero__media hero__media--placeholder" data-ken-burns data-parallax>
            {{ hero_placeholder_svg }}
          </div>
        {%- endif -%}
        <div class="hero__grain" aria-hidden="true"></div>
        {%- if first_block.settings.show_overlay -%}
          <div class="hero__overlay"></div>
        {%- endif -%}
        <div
          class="page-width hero__content"
          data-hero-content
        >
          <div class="hero__meta">
            <span class="hero__index">01</span>
            <span class="hero__meta-line"></span>
            <span class="hero__meta-label">{{ first_block.settings.eyebrow | default: 'Featured' | escape }}</span>
          </div>
          {%- if first_block.settings.heading != blank -%}
            <h1 class="hero__title" data-split-chars>{{ first_block.settings.heading | escape }}</h1>
          {%- endif -%}
          {%- if first_block.settings.subheading != blank -%}
            <p class="hero__subtitle">
              {{ first_block.settings.subheading | escape }}
            </p>
          {%- endif -%}
          {%- if first_block.settings.button_label != blank or first_block.settings.button_label_2 != blank -%}
            <div class="hero__cta">
              {%- if first_block.settings.button_label != blank -%}
                <a
                  href="{{ first_block.settings.button_link }}"
                  class="button button--primary button--lg"
                  data-magnetic
                >
                  {{- first_block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
              {%- if first_block.settings.button_label_2 != blank -%}
                <a href="{{ first_block.settings.button_link_2 }}" class="link-arrow">
                  {{ first_block.settings.button_label_2 | escape }}
                  <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        <div class="hero__scroll" aria-hidden="true">
          <span class="hero__scroll-label">Scroll</span>
          <span class="hero__scroll-line"></span>
        </div>
      </div>
    {%- endif -%}
  </section>

  <script>
    (function () {
      function splitChars(el) {
        if (el.dataset.splitReady === '1') return;
        var text = el.textContent;
        el.setAttribute('aria-label', text);
        el.textContent = '';
        var words = text.split(/(\s+)/);
        var fragment = document.createDocumentFragment();
        var charIndex = 0;
        words.forEach(function (word) {
          if (/^\s+$/.test(word)) {
            fragment.appendChild(document.createTextNode(word));
            return;
          }
          var wordEl = document.createElement('span');
          wordEl.className = 'hero__word';
          wordEl.setAttribute('aria-hidden', 'true');
          Array.from(word).forEach(function (ch) {
            var span = document.createElement('span');
            span.className = 'hero__char';
            span.textContent = ch;
            span.style.setProperty('--i', charIndex);
            charIndex += 1;
            wordEl.appendChild(span);
          });
          fragment.appendChild(wordEl);
        });
        el.appendChild(fragment);
        el.dataset.splitReady = '1';
      }

      function initHeroAnimation() {
        document.querySelectorAll('[data-hero-content]').forEach(function (content) {
          var title = content.querySelector('[data-split-chars]');
          if (title) splitChars(title);
          requestAnimationFrame(function () {
            content.classList.add('is-in');
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeroAnimation);
      } else {
        initHeroAnimation();
      }
      document.addEventListener('shopify:section:load', initHeroAnimation);
      document.addEventListener('shopify:section:select', initHeroAnimation);
      document.addEventListener('slideshow:change', function (e) {
        var slide = e.target && e.target.selectedSlide;
        if (slide) {
          var content = slide.querySelector('[data-hero-content]');
          if (content) {
            content.classList.remove('is-in');
            requestAnimationFrame(function () {
              content.classList.add('is-in');
            });
          }
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Hero / Slideshow",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centered" },
        { "value": "split",    "label": "Split (left-aligned)" }
      ],
      "default": "split"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400, "max": 1600, "step": 20, "unit": "px",
      "label": "Content max width",
      "default": 1220
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "full",   "label": "Full screen" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "min": 28, "max": 60, "step": 2, "unit": "px",
      "label": "Heading size — Mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_desktop",
      "min": 56, "max": 120, "step": 2, "unit": "px",
      "label": "Heading size — Desktop",
      "default": 72
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "heading_tracking",
      "label": "Letter spacing",
      "options": [
        { "value": "-0.04em", "label": "Very tight" },
        { "value": "-0.03em", "label": "Tight" },
        { "value": "-0.02em", "label": "Normal" },
        { "value": "-0.01em", "label": "Relaxed" }
      ],
      "default": "-0.03em"
    },
    {
      "type": "select",
      "id": "heading_leading",
      "label": "Line height",
      "options": [
        { "value": "0.98", "label": "Compact" },
        { "value": "1.02", "label": "Balanced" },
        { "value": "1.08", "label": "Relaxed" },
        { "value": "1.15", "label": "Airy" }
      ],
      "default": "1.02"
    },
    {
      "type": "header",
      "content": "Subtitle typography"
    },
    {
      "type": "range",
      "id": "sub_mobile",
      "min": 12, "max": 24, "step": 1, "unit": "px",
      "label": "Subtitle size — Mobile",
      "default": 16
    },
    {
      "type": "range",
      "id": "sub_desktop",
      "min": 16, "max": 32, "step": 1, "unit": "px",
      "label": "Subtitle size — Desktop",
      "default": 20
    },
    {
      "type": "select",
      "id": "sub_weight",
      "label": "Subtitle weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Eyebrow typography"
    },
    {
      "type": "range",
      "id": "eyebrow_mobile",
      "min": 9, "max": 16, "step": 1, "unit": "px",
      "label": "Eyebrow size — Mobile",
      "default": 11
    },
    {
      "type": "range",
      "id": "eyebrow_desktop",
      "min": 10, "max": 18, "step": 1, "unit": "px",
      "label": "Eyebrow size — Desktop",
      "default": 13
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Eyebrow weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay tint",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "min": 0, "max": 100, "step": 5, "unit": "%",
      "label": "Overlay darkness",
      "default": 55
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
