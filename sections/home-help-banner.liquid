{% comment %} Home page dark help CTA banner (from 404 page design) {% endcomment %}
<section class="section home-help">
  <style>
    .hh-max { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    @media (min-width: 768px) { .hh-max { padding: 0 32px; } }
    .hh-banner {
      position: relative; border-radius: 28px; padding: clamp(36px, 5vw, 64px);
      overflow: hidden; color: #fff;
      background: linear-gradient(135deg, #0a0a0c 0%, #1d1d1f 45%, #0071e3 120%);
    }
    .hh-banner::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(circle at 90% 10%, rgba(90,200,250,0.22), transparent 50%),
        radial-gradient(circle at 10% 100%, rgba(191,90,242,0.18), transparent 50%);
    }
    .hh-inner {
      position: relative; z-index: 1;
      display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center;
    }
    @media (max-width: 900px) { .hh-inner { grid-template-columns: 1fr; gap: 28px; } }
    .hh-eyebrow {
      font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
      color: #5ac8fa; font-weight: 600; margin-bottom: 14px;
    }
    .hh-inner h3 {
      margin: 0 0 14px; font-size: clamp(26px, 3vw, 40px);
      line-height: 1.1; letter-spacing: -0.025em; font-weight: 700;
    }
    .hh-inner p {
      margin: 0; font-size: 15.5px; line-height: 1.55; opacity: .82; max-width: 520px;
    }
    .hh-actions {
      display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
      justify-content: flex-end;
    }
    @media (max-width: 900px) { .hh-actions { justify-content: flex-start; } }
    .hh-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px;
      border-radius: 980px; font-size: 15px; font-weight: 500; text-decoration: none;
      transition: transform .2s ease, background .2s ease, border-color .2s ease;
    }
    .hh-btn:hover { transform: translateY(-1px); }
    .hh-btn--primary {
      background: #fff; color: #0a0a0c;
      box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }
    .hh-btn--primary:hover { background: #f5f5f7; }
    .hh-btn--ghost {
      color: #fff; border: 1px solid rgba(255,255,255,0.28);
    }
    .hh-btn--ghost:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.5); }
  </style>

  <div class="hh-max">
    <div class="hh-banner">
      <div class="hh-inner">
        <div>
          {%- if section.settings.eyebrow != blank -%}<div class="hh-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
          <h3>{{ section.settings.heading }}</h3>
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
        <div class="hh-actions">
          <a href="{{ section.settings.primary_link }}" class="hh-btn hh-btn--primary">
            {{ section.settings.primary_label }}
            <span aria-hidden="true">&rarr;</span>
          </a>
          {%- if section.settings.secondary_label != blank -%}
            <a href="{{ section.settings.secondary_link }}" class="hh-btn hh-btn--ghost">
              {{ section.settings.secondary_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home help banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We\u2019re here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One message away from a real person." },
    { "type": "textarea", "id": "text", "label": "Body", "default": "A Luminor specialist \u2014 not a bot \u2014 will reply within 24 hours on weekdays. We help with orders, product questions, warranty claims, or a recommendation if you\u2019re not sure what to buy." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Contact support" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Browse the store" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [
    {
      "name": "Home help banner",
      "settings": {
        "eyebrow": "We\u2019re here",
        "heading": "One message away from a real person.",
        "text": "A Luminor specialist \u2014 not a bot \u2014 will reply within 24 hours on weekdays. We help with orders, product questions, warranty claims, or a recommendation if you\u2019re not sure what to buy.",
        "primary_label": "Contact support",
        "primary_link": "/pages/contact",
        "secondary_label": "Browse the store",
        "secondary_link": "/collections/all"
      }
    }
  ]
}
{% endschema %}