{% comment %} Home page mini FAQ accordion (from 404 page design) {% endcomment %}
<section class="section home-faq">
  <style>
    .hf-max { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    @media (min-width: 768px) { .hf-max { padding: 0 32px; } }
    .hf-shell {
      background: var(--color-background-alt, #f5f5f7); border-radius: 28px;
      padding: 48px clamp(20px, 4vw, 56px);
    }
    .hf-inner { max-width: 820px; margin: 0 auto; }
    .hf-head { text-align: center; margin-bottom: 32px; }
    .hf-head h3 {
      margin: 0 0 8px; font-size: clamp(22px, 2.5vw, 30px);
      font-weight: 700; letter-spacing: -0.02em; color: var(--color-text, #1d1d1f);
    }
    .hf-head p { margin: 0; color: var(--color-text-muted, #6e6e73); font-size: 15px; }
    .hf-item { border-top: 1px solid var(--color-border, #d2d2d7); }
    .hf-item:last-child { border-bottom: 1px solid var(--color-border, #d2d2d7); }
    .hf-q {
      width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20px;
      padding: 20px 2px; background: transparent; border: 0; cursor: pointer; text-align: left;
      color: var(--color-text, #1d1d1f); font-size: 16px; font-weight: 600; font-family: inherit;
    }
    .hf-q:focus-visible { outline: 2px solid #0071e3; outline-offset: 4px; border-radius: 8px; }
    .hf-ic {
      position: relative; width: 20px; height: 20px; flex: none; border-radius: 50%;
      border: 1.5px solid var(--color-border, #d2d2d7);
      transition: transform .25s ease, background .25s ease, border-color .25s ease, color .25s ease;
      color: var(--color-text, #1d1d1f);
    }
    .hf-q[aria-expanded="true"] .hf-ic {
      transform: rotate(45deg); background: #0071e3; border-color: #0071e3; color: #fff;
    }
    .hf-ic::before, .hf-ic::after {
      content: ""; position: absolute; background: currentColor;
      top: 50%; left: 50%; transform: translate(-50%, -50%); border-radius: 1px;
    }
    .hf-ic::before { width: 10px; height: 1.5px; }
    .hf-ic::after  { width: 1.5px; height: 10px; }
    .hf-a { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
    .hf-q[aria-expanded="true"] + .hf-a { max-height: 380px; }
    .hf-a > div {
      padding: 0 2px 22px; color: var(--color-text-muted, #6e6e73);
      font-size: 15px; line-height: 1.6;
    }
    .hf-a a { color: #0071e3; text-decoration: none; }
    .hf-a a:hover { text-decoration: underline; }
    .hf-foot { text-align: center; margin-top: 28px; }
    .hf-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 980px;
      font-size: 15px; font-weight: 500; text-decoration: none; color: var(--color-text, #1d1d1f);
      background: transparent; border: 1px solid var(--color-border, #d2d2d7);
      transition: transform .2s ease, background .2s ease, border-color .2s ease;
    }
    .hf-btn:hover {
      transform: translateY(-1px);
      background: var(--color-background, #fff);
      border-color: var(--color-input-border, #86868b);
    }
  </style>

  <div class="hf-max">
    <div class="hf-shell">
      <div class="hf-inner">
        <div class="hf-head">
          <h3>{{ section.settings.heading }}</h3>
          {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
        {%- for b in section.blocks -%}
          <div class="hf-item">
            <button class="hf-q" type="button" aria-expanded="false">
              <span>{{ b.settings.question }}</span>
              <span class="hf-ic" aria-hidden="true"></span>
            </button>
            <div class="hf-a"><div>{{ b.settings.answer }}</div></div>
          </div>
        {%- endfor -%}
        <div class="hf-foot">
          <a href="{{ section.settings.see_all_link }}" class="hf-btn">
            {{ section.settings.see_all_label }}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('.home-faq');
    if (!root) return;
    var btns = root.querySelectorAll('.hf-q');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var open = btn.getAttribute('aria-expanded') === 'true';
        btns.forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    });
  })();
</script>

{% schema %}{
  "name": "Home mini FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick answers to the top three questions."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "These three alone solve more than 60% of support tickets. Still stuck? The CTA below connects you to a human."
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "See all CTA label",
      "default": "See all frequently asked questions"
    },
    {
      "type": "url",
      "id": "see_all_link",
      "label": "See all CTA link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Q&A",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Standard US shipping is 3–5 business days and <strong>free on orders over $49</strong>. Read more in our <a href=\"/pages/shipping-returns\">Shipping &amp; Returns policy</a>.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home mini FAQ (3 Q&A)",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Are the products genuine Apple products?",
            "answer": "<p>Yes. <strong>Every product sold at Luminor is a genuine Apple device</strong> sourced from Apple Authorized Distribution channels. All items ship sealed in original packaging with full Apple warranty intact. You can verify any serial number directly on Apple Check Coverage portal.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do I get Apple limited warranty and AppleCare+?",
            "answer": "<p><strong>Yes. Every new device</strong> includes Apple 1-year limited warranty from date of purchase. AppleCare+ can be added within 60 days for eligible devices - it covers accidental damage, battery service, and Express Replacement. See Warranty &amp; AppleCare+ for all the details.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How fast is shipping and what does it cost?",
            "answer": "<p><strong>Free 2-day shipping on all orders over $299.</strong> Standard shipping is $9.99 (3-5 business days) and free on orders over $99. Express and next-day options are available at checkout. Follow up anytime with Track Order. Full details in Shipping &amp; Returns.</p>"
          }
        }
      ]
    }
  ]
}{% endschema %}