{% comment %} Home page inline search section (from 404 page design) {% endcomment %}
<section class="section home-search">
  <style>
    .hs-max {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }
    @media (min-width: 768px) {
      .hs-max {
        padding: 0 32px;
      }
    }
    .hs-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px 0 0;
    }
    .hs-head {
      text-align: center;
      margin-bottom: 28px;
    }
    .hs-head__eyebrow {
      display: inline-block;
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #4F46E5;
      font-weight: 600;
      margin-bottom: 10px;
    }
    .hs-head h2 {
      margin: 0 0 10px;
      font-size: clamp(24px, 2.8vw, 34px);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--color-text, #1B1B20);
      line-height: 1.15;
    }
    .hs-head p {
      margin: 0 auto;
      max-width: 620px;
      color: var(--color-text-muted, #71717A);
      font-size: 16px;
      line-height: 1.55;
    }
    .hs-search__wrap {
      position: relative;
      width: 100%;
      max-width: 620px;
      margin: 0 auto;
    }
    .hs-search__icon {
      position: absolute;
      left: 20px;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-muted, #78716C);
      pointer-events: none;
    }
    .hs-search__icon svg {
      width: 18px;
      height: 18px;
      display: block;
    }
    .hs-search__input {
      width: 100%;
      height: 56px;
      padding: 0 20px 0 50px !important;
      border-radius: 22px;
      border: 1px solid var(--color-border, #D4D4D8);
      background: var(--color-background, #fff);
      color: var(--color-text, #1B1B20);
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      box-sizing: border-box;
    }
    .hs-search__input::placeholder {
      color: var(--color-text-muted, #78716C);
    }
    .hs-search__input:focus {
      border-color: #4F46E5;
      box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
    }
    .hs-hint {
      margin-top: 14px;
      text-align: center;
      font-size: 13px;
      color: var(--color-text-muted, #78716C);
    }
    .hs-hint a {
      color: #4F46E5;
      text-decoration: none;
      margin: 0 6px;
    }
    .hs-hint a:hover {
      text-decoration: underline;
    }
  </style>

  <div class="hs-max hs-wrap">
    <div class="hs-head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hs-head__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div style="width:100%">
      <form class="hs-search__wrap" action="{{ routes.search_url }}" method="get" role="search">
        <span class="hs-search__icon" aria-hidden="true">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
          </svg>
        </span>
        <input
          type="search"
          class="hs-search__input"
          name="q"
          placeholder="{{ section.settings.placeholder }}"
          aria-label="Search"
          autocomplete="off"
        >
      </form>
      <div class="hs-hint">
        {%- if section.settings.hint_prefix != blank -%}{{ section.settings.hint_prefix }}{%- endif -%}
        {%- for b in section.blocks -%}
          <a href="{{ b.settings.link }}">{{ b.settings.label }}</a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home search",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find it fast"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search the Luminor store."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "iPhone, iPad, Mac, Watch, AirPods, accessories and help - one search box, everything you need."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search for iPhone, MacBook, AirPods, accessories..."
    },
    {
      "type": "text",
      "id": "hint_prefix",
      "label": "Hint prefix",
      "default": "Try:"
    }
  ],
  "blocks": [
    {
      "type": "hint",
      "name": "Suggestion link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Audio"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home search",
      "blocks": [
        {
          "type": "hint",
          "settings": {
            "label": "iPhone",
            "link": "/collections/iphone"
          }
        },
        {
          "type": "hint",
          "settings": {
            "label": "MacBook",
            "link": "/collections/mac"
          }
        },
        {
          "type": "hint",
          "settings": {
            "label": "AirPods",
            "link": "/collections/airpods-home"
          }
        },
        {
          "type": "hint",
          "settings": {
            "label": "Accessories",
            "link": "/collections/accessories"
          }
        }
      ]
    }
  ]
}
{% endschema %}
