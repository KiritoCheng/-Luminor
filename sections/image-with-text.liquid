<section class="section section--flush reveal{% if section.settings.color_scheme == 'alt' %} bg-alt{% endif %}">
  <div class="page-width">
    <div class="image-with-text {% if section.settings.layout == 'text_first' %}image-with-text--reverse{% endif %} {% if section.settings.color_scheme == 'alt' %}bg-alt{% endif %}"
      {% if section.settings.color_scheme == 'alt' %}style="background-color:var(--color-bg-alt)"{% endif %}>
      <div class="image-with-text__media reveal {% if section.settings.layout == 'text_first' %}reveal--slide-right{% else %}reveal--slide-left{% endif %}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag:
            loading: 'lazy',
            widths: '375, 550, 750, 1100, 1500, 1780',
            sizes: '(max-width: 749px) 100vw, 50vw',
            alt: section.settings.image.alt | escape }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'image-with-text__placeholder' }}
        {%- endif -%}
      </div>
      <div class="image-with-text__content stagger">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="image-with-text__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "height", "label": "Image height",
      "options": [ { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ], "default": "medium" },
    { "type": "select", "id": "layout", "label": "Layout",
      "options": [ { "value": "image_first", "label": "Image first" }, { "value": "text_first", "label": "Text first" } ], "default": "image_first" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alt background" } ], "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Designed without compromise." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every Anode product is crafted with obsessive attention to detail — from premium materials to precision engineering. No compromises, no shortcuts.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Image with text" }
  ]
}
{% endschema %}
