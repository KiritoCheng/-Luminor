<section class="section">
  <div class="page-width">
    <div class="collection-hero">
      <h1 class="collection-hero__title">{{ 'sections.list_collections.title' | t }}</h1>
    </div>
    <div class="collection-list__grid" style="grid-template-columns: repeat({{ section.settings.columns | default: 3 }}, 1fr)">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-card">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: collection.title | escape }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'collection-card__placeholder' }}
          {%- endif -%}
          <div class="collection-card__overlay">
            <h3 class="collection-card__title">{{ collection.title | escape }}</h3>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List collections",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 }
  ]
}
{% endschema %}
