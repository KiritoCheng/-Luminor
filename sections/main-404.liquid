<script>
  /* ----------- Mini FAQ accordion (no framework) ----------- */
  (function () {
    var root = document.querySelector('.not-found--rich');
    if (!root) return;
    var btns = root.querySelectorAll('.nf-faq__q');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var open = btn.getAttribute('aria-expanded') === 'true';
        // close siblings (single-open)
        btns.forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    });
  })();

  /* ----------- Legacy virtual-page router (preserves existing fix) ----------- */
  (function () {
    var map = {
      'faq':              '/pages/faq',
      'about':            '/pages/about',
      'shipping-returns': '/pages/shipping-returns',
      'warranty':         '/pages/warranty',
      'track-order':      '/pages/track-order',
      'audio':            '/collections/airpods-home',
      'desk':             '/collections/mac',
      'everyday':         '/collections/accessories',
      'contact':          '/pages/contact'
    };
    try {
      var path = (location.pathname || '').replace(/\/+$/, '');
      var m = path.match(/^\/pages\/(.+)$/i);
      if (m && map[m[1]]) {
        location.replace(map[m[1]] + (location.hash || ''));
      }
    } catch (e) {}
  })();
</script>

