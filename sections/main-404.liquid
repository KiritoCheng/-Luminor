{% comment %}
  404 page — Stage 1 Hero only.
  Gradient watermark + eyebrow + heading + paragraph + CTA bar.
{% endcomment %}

<section class="section not-found not-found--rich">
  <style>
    /* ---------- Layout tokens ---------- */
    .nf-max { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
    @media (min-width: 480px) { .nf-max { padding: 0 24px; } }
    @media (min-width: 768px) { .nf-max { padding: 0 32px; } }

    /* ---------- Stage 1. Hero ---------- */
    .nf-hero {
      position: relative;
      text-align: center;
      padding-top: 48px;
      padding-bottom: 72px;
      overflow: hidden;
    }
    @media (min-width: 480px) {
      .nf-hero { padding-top: 88px; padding-bottom: 104px; }
    }
    .nf-hero__watermark {
      position: absolute;
      left: 50%;
      top: 0;
      transform: translateX(-50%);
      /*  320px → 140px (3字总宽≈252px，320px-40px padding=280px，两侧仅14px裁切)
          768px → 338px (未到上限)
          1024px+→ 420px 上限                             */
      font-size: clamp(140px, 44vw, 420px);
      line-height: 0.82;
      font-weight: 900;
      letter-spacing: -0.06em;
      font-family: system-ui, "Segoe UI", "Plus Jakarta Sans", sans-serif;
      background: linear-gradient(135deg, #4F46E5 0%, #8b5cf6 40%, #ff375f 70%, #ff9f0a 100%);
      -webkit-background-clip: text;
              background-clip: text;
      -webkit-text-fill-color: transparent;
              color: transparent;
      opacity: 0.92;
      pointer-events: none;
      user-select: none;
      white-space: nowrap;
    }
    .nf-hero__watermark::after {
      content: "";
      position: absolute;
      inset: -20% -10% 30% -10%;
      background: radial-gradient(ellipse at 30% 30%, rgba(79,70,229,0.12), transparent 55%),
                  radial-gradient(ellipse at 70% 70%, rgba(139,92,246,0.10), transparent 55%);
      filter: blur(20px);
      z-index: -1;
    }
    /*  meta 起始位置 = watermark视觉高度的 ~85%，避免与水印底部重叠
        320px: watermark≈115px高, padding-top 108px → 顶部留白+错位缓冲  */
    .nf-hero__meta { position: relative; z-index: 1; padding-top: clamp(108px, 34vw, 260px); }
    @media (min-width: 480px) { .nf-hero__meta { padding-top: clamp(160px, 22vw, 260px); } }
    .nf-eyebrow {
      display: inline-block;
      font-size: 13px;
      letter-spacing: 0.08em;
      font-weight: 600;
      text-transform: uppercase;
      color: #4F46E5;
      margin: 0 0 14px;
    }
    .nf-hero h1 {
      margin: 0 0 18px;
      font-size: clamp(32px, 5vw, 56px);
      line-height: 1.08;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--color-text, #1B1B20);
    }
    .nf-hero p.lead {
      margin: 0 auto;
      max-width: 620px;
      font-size: clamp(16px, 1.6vw, 19px);
      line-height: 1.55;
      color: var(--color-text-muted, #71717A);
    }

    /* ---------- Hero CTA bar ---------- */
    .nf-cta {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      column-gap: 12px;
      row-gap: 8px;
      margin-top: 28px;
    }
    @media (min-width: 480px) { .nf-cta { margin-top: 36px; row-gap: 12px; } }
    .nf-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;           /* WCAG 2.5.5 — 最小触控尺寸 */
      padding: 10px 20px;
      border-radius: var(--button-radius, 14px);
      font-size: 15px;
      line-height: 1.2;
      font-weight: 500;
      text-decoration: none;
      transition: transform .2s ease, background .2s ease, border-color .2s ease, color .2s ease, box-shadow .2s ease;
      box-sizing: border-box;
    }
    @media (min-width: 480px) { .nf-btn { padding: 12px 22px; } }
    .nf-btn:hover { transform: translateY(-1px); }
    .nf-btn--primary {
      background: #4F46E5;
      color: #fff;
      box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(79,70,229,0.18);
      flex: 1 1 auto;               /* 窄屏下主按钮占满整行，更易按 */
      width: 100%;
      max-width: 320px;
    }
    @media (min-width: 480px) { .nf-btn--primary { flex: 0 0 auto; width: auto; } }
    .nf-btn--primary:hover { background: #4338CA; box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 10px 28px rgba(79,70,229,0.24); }
    .nf-btn--ghost {
      color: var(--color-text, #1B1B20);
      background: transparent;
      border: 1px solid var(--color-border, #D4D4D8);
    }
    .nf-btn--ghost:hover {
      background: var(--color-background-alt, #F6F6F8);
      border-color: var(--color-input-border, #78716C);
    }
    /*  保持与兄弟按钮一致的上下 padding / min-height，
        仅缩减左右内边距以呈现"链接"视觉，同时触控区仍≥44px  */
    .nf-btn--link {
      color: #4F46E5;
      padding-top: 10px;
      padding-bottom: 10px;
      padding-left: 6px;
      padding-right: 6px;
    }
    @media (min-width: 480px) { .nf-btn--link { padding-top: 12px; padding-bottom: 12px; } }
    .nf-btn__arrow { transition: transform .2s ease; display: inline-block; }
    .nf-btn:hover .nf-btn__arrow { transform: translateX(3px); }
  </style>

  {% comment %} ==================== Stage 1. HERO ==================== {% endcomment %}
  <div class="nf-max nf-hero">
    <div class="nf-hero__watermark" aria-hidden="true">404</div>
    <div class="nf-hero__meta">
      <span class="nf-eyebrow">Nothing here</span>
      <h1>We can&rsquo;t find that page.</h1>
      <p class="lead">
        The URL you followed might be out of date, or the page may have moved.
        Use the links below to get back on track.
      </p>

      <div class="nf-cta">
        <a href="{{ routes.root_url }}" class="nf-btn nf-btn--primary">
          Back to home
          <span class="nf-btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="nf-btn nf-btn--ghost">
          Browse all products
        </a>
        <a href="/pages/faq" class="nf-btn nf-btn--link">
          Visit the help center
          <span class="nf-btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "section"
}
{% endschema %}
