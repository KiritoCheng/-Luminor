<section class="section not-found">
  <div class="page-width page-width--narrow text-center">
    <p class="eyebrow">{{ 'sections.404.eyebrow' | t }}</p>
    <h1 class="not-found__code">404</h1>
    <p class="lead color-muted" style="margin-bottom:32px">{{ 'sections.404.text' | t }}</p>
    <div class="hero__cta" style="justify-content:center">
      <a href="{{ routes.root_url }}" class="button button--primary">{{ 'sections.404.link' | t }}</a>
      <a href="{{ routes.all_products_collection_url }}" class="link-arrow">{{ 'sections.404.browse' | t }}</a>
    </div>
  </div>
</section>

<script>
  // Virtual Page Router: redirect legacy /pages/<handle> URLs to their
  // collection view equivalents so links work immediately without requiring
  // Page resources to be created in Shopify Admin.
  (function () {
    var map = {
      'faq':                '/collections/all?view=faq',
      'about':              '/collections/all?view=about',
      'shipping-returns':   '/collections/all?view=shipping-returns',
      'warranty':           '/collections/all?view=warranty',
      'track-order':        '/collections/all?view=track-order',
      'contact':            '/contact'
    };
    try {
      var path = (location.pathname || '').replace(/\/+$/, '');
      var m = path.match(/^\/pages\/(.+)$/i);
      if (m && map[m[1]]) {
        var dest = map[m[1]] + (location.hash || '');
        // replace so browser back button skips the 404 hop
        location.replace(dest);
      }
    } catch (e) {}
  })();
</script>

{% schema %}
{
  "name": "404",
  "tag": "section"
}
{% endschema %}