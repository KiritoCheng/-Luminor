<section class="password-section">
  <div class="password-section__inner">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 240 | image_tag: alt: shop.name | escape }}
    {%- else -%}
      <h1>{{ shop.name }}</h1>
    {%- endif -%}

    {%- if shop.password_message != blank -%}
      <div class="rte lead">{{ shop.password_message }}</div>
    {%- else -%}
      <p class="lead">{{ 'sections.password.opening_soon' | t }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password-form' -%}
      <input type="password" name="password" placeholder="{{ 'sections.password.placeholder' | t }}" aria-label="{{ 'sections.password.placeholder' | t }}">
      <button type="submit" class="button button--primary button--full">{{ 'sections.password.enter' | t }}</button>
      {%- if form.posted_successfully? == false -%}
        <p style="color:var(--color-text-muted);margin-top:12px">{{ 'sections.password.error' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="color-muted" style="margin-top:24px;font-size:0.875rem">
      {{ 'sections.password.admin_link_html' | t }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" }
  ]
}
{% endschema %}
