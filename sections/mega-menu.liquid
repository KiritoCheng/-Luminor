{%- comment -%}
  Mega Menu — advanced navigation dropdown with image previews.
  Designed to be used inside header-group sections as a navigation section.
{%- endcomment -%}

<div class="mega-menu" data-mega-menu>
  <a href="{{ section.settings.link }}" class="mega-menu__trigger" data-mega-trigger>
    {{ section.settings.title | escape }}
    <svg class="mega-menu__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none">
      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>

  <div class="mega-menu__panel" data-mega-panel>
    <div class="mega-menu__inner page-width">
      <div class="mega-menu__cols">
        {%- for i in (1..3) -%}
          {%- assign col_title = 'column_' | append: i | append: '_title' -%}
          {%- assign col_link_1 = 'column_' | append: i | append: '_link_1' -%}
          {%- assign col_link_2 = 'column_' | append: i | append: '_link_2' -%}
          {%- assign col_link_3 = 'column_' | append: i | append: '_link_3' -%}
          {%- assign col_label_1 = 'column_' | append: i | append: '_label_1' -%}
          {%- assign col_label_2 = 'column_' | append: i | append: '_label_2' -%}
          {%- assign col_label_3 = 'column_' | append: i | append: '_label_3' -%}

          {%- if section.settings[col_title] != blank -%}
          <div class="mega-menu__col">
            <h4 class="mega-menu__col-title">{{ section.settings[col_title] | escape }}</h4>
            <ul class="mega-menu__links">
              {%- if section.settings[col_label_1] != blank -%}
                <li><a href="{{ section.settings[col_link_1] }}">{{ section.settings[col_label_1] | escape }}</a></li>
              {%- endif -%}
              {%- if section.settings[col_label_2] != blank -%}
                <li><a href="{{ section.settings[col_link_2] }}">{{ section.settings[col_label_2] | escape }}</a></li>
              {%- endif -%}
              {%- if section.settings[col_label_3] != blank -%}
                <li><a href="{{ section.settings[col_link_3] }}">{{ section.settings[col_label_3] | escape }}</a></li>
              {%- endif -%}
            </ul>
          </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.feature_image != blank or section.settings.feature_title != blank -%}
          <div class="mega-menu__feature">
            {%- if section.settings.feature_image != blank -%}
              <div class="mega-menu__feature-image">
                {{ section.settings.feature_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  widths: '300, 400, 600',
                  sizes: '300px',
                  alt: section.settings.feature_title | escape }}
              </div>
            {%- endif -%}
            {%- if section.settings.feature_title != blank -%}
              <div class="mega-menu__feature-content">
                <h4 class="mega-menu__feature-title">{{ section.settings.feature_title | escape }}</h4>
                {%- if section.settings.feature_text != blank -%}
                  <p class="mega-menu__feature-text">{{ section.settings.feature_text | escape }}</p>
                {%- endif -%}
                {%- if section.settings.feature_link_label != blank -%}
                  <a href="{{ section.settings.feature_link }}" class="link-arrow">{{ section.settings.feature_link_label | escape }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
.mega-menu {
  position: relative;
  display: inline-flex;
}

.mega-menu__trigger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  font-size: 0.8125rem;
  font-weight: 400;
  color: var(--color-text);
  text-decoration: none;
  letter-spacing: -0.01em;
  opacity: 0.88;
  transition: opacity 0.2s ease;
  cursor: pointer;
}

.mega-menu__trigger:hover {
  opacity: 1;
}

.mega-menu__chevron {
  transition: transform 0.3s var(--ease-out-expo);
}

.mega-menu.is-open .mega-menu__chevron {
  transform: rotate(180deg);
}

.mega-menu__panel {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(-8px);
  min-width: 680px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.35s var(--ease-out-expo), transform 0.35s var(--ease-out-expo), visibility 0.35s;
  z-index: 50;  /* in-context tier (use unified z-scale; side drawers are 140) */
  pointer-events: none;
}

.mega-menu.is-open .mega-menu__panel {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
  pointer-events: auto;
}

.mega-menu__inner {
  background-color: color-mix(in srgb, var(--color-bg) 95%, transparent);
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
  border: 1px solid color-mix(in srgb, var(--color-text) 6%, transparent);
  border-radius: 24px;
  box-shadow: 0 12px 48px color-mix(in srgb, var(--color-text) 15%, transparent);
  padding: 32px;
}

.mega-menu__cols {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1.2fr;
  gap: 32px;
}

.mega-menu__col-title {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-muted);
  margin-bottom: 16px;
}

.mega-menu__links {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.mega-menu__links a {
  font-size: 0.875rem;
  color: var(--color-text);
  text-decoration: none;
  transition: color 0.2s ease, transform 0.2s ease;
  display: inline-block;
}

.mega-menu__links a:hover {
  color: var(--color-primary);
  transform: translateX(4px);
}

.mega-menu__feature {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mega-menu__feature-image {
  border-radius: var(--image-radius);
  overflow: hidden;
  aspect-ratio: 4 / 3;
}

.mega-menu__feature-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s var(--ease-out-expo);
}

.mega-menu__feature:hover .mega-menu__feature-image img {
  transform: scale(1.04);
}

.mega-menu__feature-title {
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.mega-menu__feature-text {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  line-height: 1.5;
}

@media (max-width: 990px) {
  .mega-menu__panel {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Mega menu",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Menu title", "default": "Shop" },
    { "type": "url", "id": "link", "label": "Menu link" },
    { "type": "header", "content": "Column 1" },
    { "type": "text", "id": "column_1_title", "label": "Title", "default": "Audio" },
    { "type": "text", "id": "column_1_label_1", "label": "Link 1 label", "default": "Headphones" },
    { "type": "url", "id": "column_1_link_1", "label": "Link 1 URL" },
    { "type": "text", "id": "column_1_label_2", "label": "Link 2 label", "default": "Speakers" },
    { "type": "url", "id": "column_1_link_2", "label": "Link 2 URL" },
    { "type": "text", "id": "column_1_label_3", "label": "Link 3 label", "default": "Earbuds" },
    { "type": "url", "id": "column_1_link_3", "label": "Link 3 URL" },
    { "type": "header", "content": "Column 2" },
    { "type": "text", "id": "column_2_title", "label": "Title", "default": "Desk" },
    { "type": "text", "id": "column_2_label_1", "label": "Link 1 label", "default": "Lamps" },
    { "type": "url", "id": "column_2_link_1", "label": "Link 1 URL" },
    { "type": "text", "id": "column_2_label_2", "label": "Link 2 label", "default": "Keyboards" },
    { "type": "url", "id": "column_2_link_2", "label": "Link 2 URL" },
    { "type": "text", "id": "column_2_label_3", "label": "Link 3 label", "default": "Chargers" },
    { "type": "url", "id": "column_2_link_3", "label": "Link 3 URL" },
    { "type": "header", "content": "Column 3" },
    { "type": "text", "id": "column_3_title", "label": "Title", "default": "Everyday" },
    { "type": "text", "id": "column_3_label_1", "label": "Link 1 label", "default": "Wallets" },
    { "type": "url", "id": "column_3_link_1", "label": "Link 1 URL" },
    { "type": "text", "id": "column_3_label_2", "label": "Link 2 label", "default": "Watches" },
    { "type": "url", "id": "column_3_link_2", "label": "Link 2 URL" },
    { "type": "text", "id": "column_3_label_3", "label": "Link 3 label", "default": "Accessories" },
    { "type": "url", "id": "column_3_link_3", "label": "Link 3 URL" },
    { "type": "header", "content": "Featured" },
    { "type": "image_picker", "id": "feature_image", "label": "Feature image" },
    { "type": "text", "id": "feature_title", "label": "Feature title", "default": "New arrivals" },
    { "type": "text", "id": "feature_text", "label": "Feature text", "default": "Discover our latest collection" },
    { "type": "text", "id": "feature_link_label", "label": "Feature link label", "default": "Shop now" },
    { "type": "url", "id": "feature_link", "label": "Feature link" }
  ],
  "presets": [
    { "name": "Mega menu" }
  ]
}
{% endschema %}
