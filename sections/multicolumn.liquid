{%- liquid
  assign columns = section.settings.columns | default: 3
-%}

<section class="section multicolumn reveal{% if section.settings.color_scheme == 'alt' %} bg-alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="multicolumn__title">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2>{{ section.settings.title | escape }}</h2>{%- endif -%}
        {%- if section.settings.subtitle != blank -%}<p class="lead color-muted">{{ section.settings.subtitle | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="multicolumn__grid stagger" style="grid-template-columns: repeat({{ columns }}, 1fr)">
      {%- for block in section.blocks -%}
        <div class="multicolumn__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="multicolumn__media media media--hover-zoom media--square">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.image.alt | escape }}
            </div>
          {%- else -%}
            <div class="multicolumn__media media--square">
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'multicolumn__placeholder' }}
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="multicolumn__item-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="multicolumn__item-text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <p style="margin-top:12px"><a href="{{ block.settings.link }}" class="link-arrow">{{ block.settings.link_label | escape }}</a></p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="multicolumn__cta">
        <a href="{{ section.settings.button_link }}" class="button button--secondary">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "default", "label": "Default" }, { "value": "alt", "label": "Alt background" } ], "default": "alt" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Why you'll love it" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Column title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pair text with an image to focus on a product or feature." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
