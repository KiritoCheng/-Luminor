{%- comment -%}
  Press — "Featured on" section with media logos and review quotes.
{%- endcomment -%}

<section class="section section--tight press reveal">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="press__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="press__logos stagger">
      {%- for block in section.blocks -%}
        {%- if block.type == 'logo' -%}
          <div class="press__logo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.name | escape }}
            {%- elsif block.settings.name != blank -%}
              <span class="press__logo-text">{{ block.settings.name | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign quote_blocks = section.blocks | where: 'type', 'quote' -%}
    {%- if quote_blocks.size > 0 -%}
      <div class="press__quotes" data-press-quotes>
        {%- for block in quote_blocks -%}
          <blockquote class="press__quote" {{ block.shopify_attributes }}>
            <p class="press__quote-text">"{{ block.settings.quote | escape }}"</p>
            <cite class="press__quote-source">{{ block.settings.source | escape }}</cite>
          </blockquote>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
.press {
  text-align: center;
}

.press__title {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-text-muted);
  margin-bottom: 32px;
}

.press__logos {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 40px;
  margin-bottom: 48px;
}

.press__logo {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  opacity: 0.5;
  transition: opacity 0.3s ease;
}

.press__logo:hover {
  opacity: 0.85;
}

.press__logo img {
  max-height: 32px;
  width: auto;
  filter: grayscale(1);
}

.press__logo-text {
  font-size: 1.125rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.press__quotes {
  position: relative;
  max-width: 720px;
  margin: 0 auto;
  overflow: hidden;
}

.press__quote {
  display: none;
  margin: 0;
}

.press__quote:first-child {
  display: block;
}

.press__quote-text {
  font-size: clamp(1.125rem, 2vw, 1.5rem);
  line-height: 1.5;
  font-weight: 400;
  color: var(--color-text);
  margin-bottom: 12px;
}

.press__quote-source {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-text-muted);
  font-style: normal;
}

@media (max-width: 749px) {
  .press__logos {
    gap: 24px;
  }
  .press__logo {
    height: 28px;
  }
}
</style>

<script>
(function() {
  function initPress() {
    document.querySelectorAll('[data-press-quotes]').forEach(function(container) {
      var quotes = container.querySelectorAll('.press__quote');
      if (quotes.length <= 1) return;
      var idx = 0;
      setInterval(function() {
        quotes[idx].style.display = 'none';
        idx = (idx + 1) % quotes.length;
        quotes[idx].style.display = 'block';
      }, 5000);
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPress);
  } else {
    initPress();
  }
  document.addEventListener('shopify:section:load', initPress);
})();
</script>

{% schema %}
{
  "name": "Press",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Featured on" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "logo",
      "name": "Media logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Name (if no image)", "default": "MKBHD" },
        { "type": "image_picker", "id": "image", "label": "Logo image" }
      ]
    },
    {
      "type": "quote",
      "name": "Review quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "I've gone on to basically replace all of my functional battery banks in my life with these." },
        { "type": "text", "id": "source", "label": "Source", "default": "MKBHD" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press",
      "blocks": [
        { "type": "logo", "settings": { "name": "MKBHD" } },
        { "type": "logo", "settings": { "name": "TechSource" } },
        { "type": "logo", "settings": { "name": "Austin Evans" } },
        { "type": "logo", "settings": { "name": "Linus Tech Tips" } },
        { "type": "quote", "settings": { "quote": "I've gone on to basically replace all of my functional battery banks in my life with these.", "source": "MKBHD" } },
        { "type": "quote", "settings": { "quote": "SHARGE is a company who tend to do batteries in a more interesting way.", "source": "Austin Evans" } },
        { "type": "quote", "settings": { "quote": "If you don't have a dedicated spot in your setup to charge your devices, then you're gonna love SHARGE.", "source": "Linus Tech Tips" } }
      ]
    }
  ]
}
{% endschema %}
