{%- comment -%}
  Press — "Featured on" marquee scrolling band with media logos and review quotes.
{%- endcomment -%}

{%- liquid
  assign logo_blocks = section.blocks | where: 'type', 'logo'
  assign quote_blocks = section.blocks | where: 'type', 'quote'
-%}

<section class="section section--tight press reveal" style="--press-marquee-duration: {{ section.settings.marquee_speed }}s;">
  {%- if section.settings.title != blank -%}
    <div class="page-width">
      <h2 class="press__title">{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  {%- if logo_blocks.size > 0 -%}
    <div class="press__marquee" data-press-marquee>
      <div class="press__marquee-track">
        {%- for block in logo_blocks -%}
          <div class="press__logo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 200
                | image_tag: loading: 'lazy', alt: block.settings.name
                | escape
              }}
            {%- elsif block.settings.name != blank -%}
              <span class="press__logo-text">{{ block.settings.name | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if quote_blocks.size > 0 -%}
    <div class="page-width">
      <div class="press__quotes" data-press-quotes>
        {%- for block in quote_blocks -%}
          <blockquote class="press__quote" {{ block.shopify_attributes }}>
            <p class="press__quote-text">"{{ block.settings.quote | escape }}"</p>
            <cite class="press__quote-source">{{ block.settings.source | escape }}</cite>
          </blockquote>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  .press {
    text-align: center;
    overflow: hidden;
  }

  .press__title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: 32px;
  }

  /* ---- Marquee scrolling band ---- */
  .press__marquee {
    display: flex;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    margin-bottom: 48px;
    justify-content: center;
  }

  .press__marquee-track {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: max-content;
  }

  .press__marquee:hover .press__marquee-track {
    animation-play-state: paused;
  }

  .press__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 32px;
    opacity: 0.45;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }

  .press__logo:hover {
    opacity: 0.85;
  }

  .press__logo img {
    max-height: 36px;
    width: auto;
    filter: grayscale(1);
  }

  .press__logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .press__marquee-track {
      animation: none !important;
    }
    .press__marquee {
      justify-content: center;
    }
  }

  /* ---- Quotes ---- */
  .press__quotes {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    overflow: hidden;
  }

  .press__quote {
    display: none;
    margin: 0;
  }

  .press__quote:first-child {
    display: block;
  }

  .press__quote-text {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.5;
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .press__quote-source {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    font-style: normal;
  }

  @media (max-width: 749px) {
    .press__logo {
      height: 30px;
      padding: 0 24px;
    }
    .press__logo img {
      max-height: 30px;
    }
    .press__logo-text {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  (function () {
    var DYN_STYLE_ID = 'press-marquee-dyn-style';

    function getDynSheet() {
      var el = document.getElementById(DYN_STYLE_ID);
      if (!el) {
        el = document.createElement('style');
        el.id = DYN_STYLE_ID;
        document.head.appendChild(el);
      }
      return el.sheet;
    }

    function initPressMarquee() {
      var prefersReduced =
        window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll('[data-press-marquee]').forEach(function (marquee) {
        var track = marquee.querySelector('.press__marquee-track');
        if (!track) return;

        // Clean up previous clones & animation
        track.querySelectorAll('[data-clone]').forEach(function (c) { c.remove(); });
        track.style.animation = '';

        var originals = Array.prototype.slice.call(
          track.querySelectorAll('.press__logo:not([data-clone])')
        );
        if (originals.length === 0) return;

        if (prefersReduced) return; // static, centered via CSS

        var W = marquee.offsetWidth;
        var L = track.scrollWidth; // single set width
        if (L <= 0 || W <= 0) return;

        // Center + seamless condition: L >= W/(n-2) => n >= W/L + 2.
        // Pad to guarantee coverage on any viewport / logo count.
        var n = Math.ceil(W / L) + 3;
        n = Math.max(n, 4);

        for (var i = 1; i < n; i++) {
          originals.forEach(function (item) {
            var clone = item.cloneNode(true);
            clone.setAttribute('data-clone', '');
            clone.setAttribute('aria-hidden', 'true');
            track.appendChild(clone);
          });
        }

        var duration =
          window.getComputedStyle(marquee).getPropertyValue('--press-marquee-duration').trim() ||
          '50s';

        var sheet = getDynSheet();
        while (sheet.cssRules.length) sheet.deleteRule(0);
        var pct = (100 / n).toFixed(4);
        sheet.insertRule(
          '@keyframes press-marquee-run { from { transform: translateX(0); } to { transform: translateX(-' + pct + '%); } }',
          0
        );
        track.style.animation = 'press-marquee-run ' + duration + ' linear infinite';
      });
    }

    function initPressQuotes() {
      document.querySelectorAll('[data-press-quotes]').forEach(function (container) {
        var quotes = container.querySelectorAll('.press__quote');
        if (quotes.length <= 1) return;
        var idx = 0;
        setInterval(function () {
          quotes[idx].style.display = 'none';
          idx = (idx + 1) % quotes.length;
          quotes[idx].style.display = 'block';
        }, 5000);
      });
    }

    function initPress() {
      initPressMarquee();
      initPressQuotes();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPress);
    } else {
      initPress();
    }
    document.addEventListener('shopify:section:load', initPress);

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(initPressMarquee, 250);
    });
  })();
</script>

{% schema %}{
  "name": "Press",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured on"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee duration",
      "min": 15,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 50
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "logo",
      "name": "Media logo",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name (if no image)",
          "default": "MKBHD"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Review quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I've gone on to basically replace all of my functional battery banks in my life with these."
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source",
          "default": "MKBHD"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "name": "9to5Mac"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "MacRumors"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "The Verge"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "iMore"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "AppleInsider"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "Cult of Mac"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Titanium makes the iPhone 15 Pro feel like a totally different class of device.",
            "source": "The Verge"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "The M3 Max is the kind of performance leap we haven't seen in mobile silicon in years.",
            "source": "9to5Mac"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Apple Watch Ultra 2 is the best outdoor smartwatch on the market - bar none.",
            "source": "iMore"
          }
        }
      ]
    }
  ]
}{% endschema %}
