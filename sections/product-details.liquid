    .anode-product__info { max-width: none; padding-top: 28px; }
    .anode-product__info-head { margin-bottom: 22px; }
    .anode-product .product__title { font-size: clamp(2.1rem, 11vw, 3.2rem); }
    .anode-product .product__block + .product__block { margin-top: 19px; }
    .anode-product__purchase { position: sticky; bottom: 10px; z-index: 8; margin-inline: -8px; padding: 10px 8px; background: color-mix(in srgb, var(--color-background, #fff) 94%, transparent); backdrop-filter: blur(10px); }
    .anode-product .product__buy-buttons .button--primary { min-height: 54px; }
    .anode-product__signature { margin-top: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
