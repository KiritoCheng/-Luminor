{%- liquid
  assign product = product | default: section.settings.product
  assign current_variant = product.selected_or_first_available_variant
  assign current_selling_plan_allocation = current_variant.selling_plan_allocations | first
  if product.selected_selling_plan
    assign current_selling_plan_allocation = current_variant.selling_plan_allocations | where: 'selling_plan', product.selected_selling_plan | first
  endif
  assign product_form_id = 'product-form-' | append: section.id
  assign main_alt = product.featured_image.alt | default: product.title | escape
  assign show_thumbs = false
  if product.media.size > 1
    assign show_thumbs = true
  endif
-%}

<section class="section anode-product" data-product-section>
  <div class="page-width">
    <div class="anode-product__intro" aria-hidden="true">
      <span class="anode-product__index">01</span>
      <span class="anode-product__rule"></span>
      <span class="anode-product__label">Product / Detail</span>
    </div>

    <div class="product anode-product__layout {% if section.settings.enable_sticky %}anode-product__layout--sticky{% endif %}">
      <div class="product__media anode-product__media" data-product-gallery>
        <div class="anode-product__media-count" aria-hidden="true">
          <span>{{ product.media.size | prepend: '0' | slice: -2, 2 }}</span>
          <span>/</span>
          <span>{{ product.media.size | prepend: '0' | slice: -2, 2 }}</span>
        </div>

        <div class="product__media-main anode-product__media-main" data-product-main>
          {%- if product.featured_media -%}
            {%- for media in product.media limit: 1 -%}
              {%- render 'product-media', media: media, main_alt: main_alt -%}
            {%- endfor -%}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product__placeholder' }}
          {%- endif -%}
        </div>

        {%- if show_thumbs -%}
          <div class="product__thumbs anode-product__thumbs" data-product-thumbs aria-label="Product media">
            {%- for media in product.media limit: 8 -%}
              {%- liquid
                assign thumb_alt = media.alt | default: product.title | escape
                assign thumb_active = ''
                if forloop.first
                  assign thumb_active = 'is-active'
                endif
              -%}
              <button type="button" class="product__thumb anode-product__thumb {{ thumb_active }}" data-product-thumb data-media-id="{{ media.id }}" data-main-url="{{ media | image_url: width: 1600 }}" aria-label="View product image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                {%- if media.media_type == 'image' -%}
                  {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: thumb_alt }}
                {%- else -%}
                  <span class="product__thumb-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<path d="m22 8-6 4 6 4V8Z"/><rect x="2" y="6" width="14" height="12" rx="2"/>{%- elsif media.media_type == 'model' -%}<path d="M12 2 2 7v10l10 5 10-5V7L12 2Z"/><path d="m2 7 10 5 10-5"/><path d="M12 22V12"/>{%- endif -%}</svg>
                  </span>
                  {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: thumb_alt }}
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info anode-product__info">
        <div class="anode-product__info-head">
          <span class="anode-product__micro">ANODE / OBJECT</span>
          <span class="anode-product__status">{{ current_variant.available | default: false | if: 'Available', 'Unavailable' }}</span>
        </div>

        {%- form 'product', product, id: product_form_id, class: 'product__form anode-product__form', data-product-form: '', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          <div class="product__payment-terms" data-payment-terms>
            {{ form | payment_terms }}
          </div>

          {%- for block in section.blocks -%}
            <div class="product__block product__block--{{ block.type }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when 'vendor' -%}
                  {%- if product.vendor != blank -%}
                    <p class="product__vendor">{{ product.vendor | escape }}</p>
                  {%- endif -%}

                {%- when 'title' -%}
                  <div class="anode-product__title-wrap">
                    <span class="anode-product__title-mark" aria-hidden="true">/</span>
                    <h1 class="product__title">{{ product.title | escape }}</h1>
                  </div>

                {%- when 'price' -%}
                  <div class="anode-product__price-row">
                    <div class="product__price" data-price>
                      {% render 'price', product: product, variant: current_variant, selling_plan_allocation: current_selling_plan_allocation %}
                    </div>
                    <span data-compare-price hidden></span>
                  </div>
                  {%- if cart.taxes_included -%}
                    <p class="product__tax-note color-muted">{{ 'products.product.taxes_included' | t | default: 'Tax included' }}</p>
                  {%- endif -%}

                {%- when 'rating' -%}
                  {%- if product.metafields.reviews.rating.value != blank -%}
                    <div class="product__rating" aria-label="{{ product.metafields.reviews.rating.value }} out of 5 stars">
                      <span class="product__rating-value">{{ product.metafields.reviews.rating.value }}</span>
                      <span class="product__rating-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                      <span class="product__rating-count color-muted">({{ product.metafields.reviews.rating_count.value | default: 0 }})</span>
                    </div>
                  {%- endif -%}

                {%- when 'variant_picker' -%}
                  <div class="product__options" data-variant-picker>
                    {%- for option in product.options_with_values -%}
                      {%- liquid
                        assign is_color = false
                        assign opt_name_down = option.name | downcase
                        if opt_name_down == 'color' or opt_name_down == 'colour'
                          assign is_color = true
                        endif
                      -%}
                      <fieldset class="product__option" data-option-group data-option-index="{{ forloop.index0 }}">
                        <legend class="product__option-label"><span>{{ option.name | escape }}</span><strong data-option-label>{{ option.selected_value | escape }}</strong></legend>
                        <div class="product__option-values">
                          {%- for value in option.values -%}
                            {%- liquid
                              assign swatch = value.swatch
                              assign swatch_style = ''
                              assign swatch_image = nil
                              if swatch != blank
                                if swatch.image
                                  assign swatch_image = swatch.image
                                  assign swatch_style = 'background-image: url(' | append: swatch_image | image_url: width: 80 | append: '); background-size: cover; background-position: center;'
                                elsif swatch.color
                                  assign swatch_style = 'background-color: ' | append: swatch.color | append: ';'
                                endif
                              endif
                              assign value_active = ''
                              if option.selected_value == value
                                assign value_active = 'is-active'
                              endif
                            -%}
                            <button type="button" class="product__option-value {% if is_color or swatch != blank %}product__option-value--swatch{% endif %} {{ value_active }}" data-option-value="{{ value | escape }}" {% if swatch_style != '' %}style="{{ swatch_style }}"{% endif %} {% if is_color == false and swatch == blank %}aria-label="{{ value | escape }}"{% endif %} aria-pressed="{% if value_active != blank %}true{% else %}false{% endif %}">
                              {%- if is_color == false and swatch == blank -%}<span class="product__option-label-text">{{ value | escape }}</span>{%- endif -%}
                              <span class="visually-hidden">{{ value | escape }}</span>
                            </button>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  </div>

                {%- when 'selling_plans' -%}
                  {%- if product.selling_plan_groups.size > 0 -%}
                    <div class="product__selling-plans" data-selling-plans>
                      <label class="product__option-label" for="SellingPlan-{{ section.id }}"><span>{{ 'products.product.selling_plan' | t | default: 'Purchase plan' }}</span></label>
                      <select name="selling_plan" id="SellingPlan-{{ section.id }}" data-selling-plan-select>
                        <option value="" {% unless product.selected_selling_plan %}selected{% endunless %}>{{ 'products.product.one_time_purchase' | t | default: 'One-time purchase' }}</option>
                        {%- for group in product.selling_plan_groups -%}
                          <optgroup label="{{ group.name | escape }}">
                            {%- for plan in group.selling_plans -%}
                              <option value="{{ plan.id }}" {% if product.selected_selling_plan.id == plan.id %}selected{% endif %}>{{ plan.name | escape }}</option>
                            {%- endfor -%}
                          </optgroup>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- endif -%}

                {%- when 'quantity' -%}
                  <div class="product__qty anode-product__quantity">
                    <label class="product__qty-label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
                    <div class="qty-stepper">
                      <button type="button" data-qty-step="down" aria-label="{{ 'products.product.quantity.decrease' | t }}">&minus;</button>
                      <input type="number" name="quantity" value="1" min="1" id="Quantity-{{ section.id }}" data-qty-input>
                      <button type="button" data-qty-step="up" aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
                    </div>
                  </div>

                {%- when 'buy_buttons' -%}
                  <div class="product__buy-buttons anode-product__purchase" {{ block.shopify_attributes }}>
                    <button type="submit" name="add" class="button button--primary button--full button--lg" data-add-to-cart data-available="{{ 'products.product.add_to_cart' | t }}" data-sold-out="{{ 'products.product.sold_out' | t }}" {% unless current_variant.available %}disabled{% endunless %}>
                      <span>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                      <span aria-hidden="true">↗</span>
                    </button>
                    {%- if block.settings.show_dynamic_checkout -%}
                      {{ form | payment_button }}
                    {%- endif -%}
                    <p class="anode-product__purchase-note">Secure checkout · Flexible payments</p>
                  </div>

                {%- when 'gift_card_recipient' -%}
                  {%- if product.gift_card? and block.settings.show_recipient_form -%}
                    <div class="product__gift-recipient" data-gift-card-recipient>
                      <p class="product__gift-recipient-label">{{ block.settings.recipient_label | default: 'Send as a gift' }}</p>
                      <label class="field"><span class="field__label">{{ 'products.product.recipient_email' | t | default: 'Recipient email' }}</span><input type="email" name="properties[Recipient email]" value="{{ form.email }}" autocomplete="email" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}></label>
                      <label class="field"><span class="field__label">{{ 'products.product.recipient_name' | t | default: 'Recipient name (optional)' }}</span><input type="text" name="properties[Recipient name]" value="{{ form.name }}" autocomplete="name"></label>
                      <label class="field field--textarea"><span class="field__label">{{ 'products.product.recipient_message' | t | default: 'Message (optional)' }}</span><textarea name="properties[Recipient message]" rows="3">{{ form.message }}</textarea></label>
                      <label class="field"><span class="field__label">{{ 'products.product.send_on' | t | default: 'Send on (optional)' }}</span><input type="date" name="properties[Send on]" value="{{ form.send_on }}"></label>
                    </div>
                  {%- endif -%}

                {%- when 'pickup_availability' -%}
                  {%- assign pickup = current_variant.store_pickup_availability -%}
                  {%- if pickup != blank -%}
                    <div class="product__pickup" data-pickup-availability>
                      {%- if pickup.available -%}
                        <p class="product__pickup-status product__pickup-status--available"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{{ 'products.product.pickup_available' | t | default: 'Available for pickup' }}</p>
                        {%- if pickup.pick_up_time -%}<p class="product__pickup-time color-muted">{{ pickup.pick_up_time }}</p>{%- endif -%}
                      {%- else -%}
                        <p class="product__pickup-status product__pickup-status--unavailable color-muted">{{ 'products.product.pickup_unavailable' | t | default: 'Not available for pickup' }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                {%- when 'follow_on_shop' -%}
                  {%- if block.settings.enable_follow_on_shop -%}<div class="product__follow-shop">{{ form | login_button }}</div>{%- endif -%}

                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="product__description rte">{{ product.description }}</div>
                  {%- endif -%}

                {%- when 'accordion' -%}
                  <details class="product__accordion-item" {{ block.shopify_attributes }} data-accordion-item>
                    <summary class="product__accordion-summary"><span class="product__accordion-heading">{{ block.settings.heading | escape | default: 'Details' }}</span><span class="product__accordion-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
                    <div class="product__accordion-content rte">{%- if block.settings.text != blank -%}{{ block.settings.text }}{%- elsif block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}</div>
                  </details>

                {%- when 'share' -%}
                  <div class="product__share"><a href="{{ product.url }}" class="link-arrow">{{ 'products.product.share' | t | default: 'Share' }} <span aria-hidden="true">↗</span></a></div>

                {%- when 'custom_liquid' -%}
                  {%- if block.settings.custom_liquid != blank -%}<div class="product__custom-liquid">{{ block.settings.custom_liquid }}</div>{%- endif -%}

                {%- when '@app' -%}
                  {% render block %}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- endform -%}

        <div class="anode-product__signature" aria-hidden="true">
          <span>ANODE</span><span>FORM / FUNCTION / DETAIL</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-product-variants>
  [
    {%- for variant in product.variants -%}
    {
      "id": {{ variant.id }},
      "available": {{ variant.available }},
      "options": {{ variant.options | json }},
      "price": {{ variant.price | json }},
      "price_formatted": {{ variant.price | money | json }},
      "compare_at_price": {{ variant.compare_at_price | json }},
      "compare_at_price_formatted": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
      "featured_image": {% if variant.featured_media %}{"id": {{ variant.featured_media.id }}, "url": {{ variant.featured_media | image_url: width: 1600 | json }}}{% else %}null{% endif %},
      "unit_price_formatted": {% if variant.unit_price_measurement %}{{ variant.unit_price | money | json }}{% else %}null{% endif %}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script type="application/json" data-selling-plan-allocations>
  {%- if product.selling_plan_groups.size > 0 -%}
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": [
          {%- for allocation in variant.selling_plan_allocations -%}
            {
              "selling_plan_id": {{ allocation.selling_plan.id }},
              "name": {{ allocation.selling_plan.name | json }},
              "price": {{ allocation.price | money_without_currency | json }},
              "compare_at_price": {{ allocation.compare_at_price | money_without_currency | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  {%- else -%}
    {}
  {%- endif -%}
</script>

<script type="application/json" data-variant-media>
  {%- liquid
    assign variant_media = ''
    for variant in product.variants
      if variant.featured_media
        assign mid = variant.featured_media.id
        assign variant_media = variant_media | append: '"' | append: variant.id | append: '":' | append: mid
        unless forloop.last
          assign variant_media = variant_media | append: ','
        endunless
      endif
    endfor
  -%}
  { {{ variant_media }} }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 200 | json }},
    {%- if product.featured_image -%}
      "image": ["https:{{ product.featured_image | image_url: width: 1200 }}"],
    {%- endif -%}
    "sku": {{ current_variant.sku | default: product.id | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    "offers": {
      "@type": "Offer",
      "url": {{ canonical_url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | money_without_currency | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition"
    }
  }
</script>

<style>
  .anode-product { --anode-product-line: color-mix(in srgb, var(--color-text, #1b1b20) 13%, transparent); }
  .anode-product__intro { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; margin-bottom: 22px; color: var(--color-text-muted, #71717a); font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .anode-product__index { color: var(--color-text, #1b1b20); font-weight: 700; }
  .anode-product__rule { height: 1px; background: var(--anode-product-line); }
  .anode-product__label { white-space: nowrap; }
  .anode-product__layout { align-items: start; gap: clamp(38px, 6vw, 96px); }
  .anode-product__layout--sticky .anode-product__info { position: sticky; top: 32px; }
  .anode-product__media { position: relative; min-width: 0; }
  .anode-product__media-main { position: relative; overflow: hidden; background: color-mix(in srgb, var(--color-text, #1b1b20) 3%, var(--color-background, #fff)); }
  .anode-product__media-main::before { content: ""; position: absolute; z-index: 2; left: 0; top: 0; width: 3px; height: 26%; background: var(--color-primary, #4f46e5); pointer-events: none; }
  .anode-product__media-count { position: absolute; z-index: 3; right: 14px; top: 14px; display: flex; gap: 5px; font-size: 0.625rem; letter-spacing: 0.1em; font-variant-numeric: tabular-nums; mix-blend-mode: multiply; }
  .anode-product__thumbs { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 8px; margin-top: 10px; }
  .anode-product__thumb { width: 100%; aspect-ratio: 1; padding: 0; border: 1px solid var(--anode-product-line); background: transparent; overflow: hidden; position: relative; cursor: pointer; transition: border-color .2s ease, transform .2s ease; }
  .anode-product__thumb:hover { transform: translateY(-2px); border-color: var(--color-text, #1b1b20); }
  .anode-product__thumb.is-active { border-color: var(--color-primary, #4f46e5); box-shadow: inset 0 0 0 1px var(--color-primary, #4f46e5); }
  .anode-product__thumb[aria-current="true"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--color-primary, #4f46e5); }
  .anode-product__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .anode-product__info { min-width: 0; max-width: 620px; }
  .anode-product__info-head { display: flex; justify-content: space-between; align-items: center; gap: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--anode-product-line); margin-bottom: 28px; font-size: 0.625rem; letter-spacing: .14em; text-transform: uppercase; }
  .anode-product__micro { color: var(--color-text-muted, #71717a); }
  .anode-product__status { font-weight: 700; }
  .anode-product__form { position: relative; }
  .product__block { margin: 0; padding: 0; }
  .product__block + .product__block { margin-top: 22px; }
  .product__block--vendor { margin-top: 0; }
  .product__vendor { margin: 0; font-size: .6875rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--color-primary, #4f46e5); }
  .anode-product__title-wrap { display: grid; grid-template-columns: 24px 1fr; gap: 10px; align-items: start; }
  .anode-product__title-mark { font-size: 1.25rem; line-height: 1.2; color: var(--color-primary, #4f46e5); font-weight: 700; }
  .anode-product .product__title { margin: 0; font-size: clamp(2rem, 3.8vw, 4.25rem); line-height: .98; letter-spacing: -.055em; font-weight: 600; text-wrap: balance; }
  .anode-product__price-row { display: flex; align-items: baseline; gap: 12px; padding: 17px 0; border-top: 1px solid var(--anode-product-line); border-bottom: 1px solid var(--anode-product-line); }
  .anode-product .product__price { font-size: 1.25rem; font-weight: 650; letter-spacing: -.025em; }
  .anode-product .product__tax-note { margin: 7px 0 0; font-size: .6875rem; }
  .anode-product .product__rating { display: inline-flex; align-items: center; gap: 7px; font-size: .75rem; }
  .anode-product .product__rating-stars { color: var(--color-text, #1b1b20); letter-spacing: 1px; }
  .anode-product .product__rating-value { font-weight: 700; }
  .anode-product .product__options { display: flex; flex-direction: column; gap: 25px; }
  .anode-product .product__option { border: 0; padding: 0; margin: 0; min-width: 0; }
  .anode-product .product__option-label { display: flex; justify-content: space-between; gap: 15px; margin: 0 0 11px; font-size: .6875rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-muted, #71717a); }
  .anode-product .product__option-label strong { color: var(--color-text, #1b1b20); font-weight: 700; letter-spacing: 0; text-transform: none; }
  .anode-product .product__option-values { display: flex; flex-wrap: wrap; gap: 8px; }
  .anode-product .product__option-value { min-width: 44px; min-height: 44px; padding: 8px 15px; border: 1px solid var(--anode-product-line); border-radius: 2px; background: transparent; color: var(--color-text, #1b1b20); font: inherit; font-size: .8125rem; cursor: pointer; transition: border-color .2s ease, background-color .2s ease, transform .15s ease; }
  .anode-product .product__option-value:hover { border-color: var(--color-text, #1b1b20); transform: translateY(-1px); }
  .anode-product .product__option-value.is-active { border-color: var(--color-primary, #4f46e5); background: color-mix(in srgb, var(--color-primary, #4f46e5) 7%, transparent); box-shadow: inset 0 0 0 1px var(--color-primary, #4f46e5); }
  .anode-product .product__option-value--swatch { width: 38px; height: 38px; min-width: 38px; min-height: 38px; padding: 0; border-radius: 50%; }
  .anode-product .product__option-value--swatch.is-active { box-shadow: 0 0 0 2px var(--color-background, #fff), 0 0 0 4px var(--color-primary, #4f46e5); }
  .anode-product .product__selling-plans select,
  .anode-product .product__gift-recipient input,
  .anode-product .product__gift-recipient textarea,
  .anode-product .product__gift-recipient select { width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid var(--anode-product-line); border-radius: 2px; background: var(--color-background, #fff); color: var(--color-text, #1b1b20); font: inherit; font-size: .8125rem; }
  .anode-product .product__selling-plans select:focus,
  .anode-product .product__gift-recipient input:focus,
