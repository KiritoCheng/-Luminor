{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky product details on desktop",
      "default": true
    }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1 },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Color options automatically use Shopify swatches (swatch.color and swatch.image)." }
      ]
    },
    { "type": "selling_plans", "name": "Selling plans", "limit": 1 },
    { "type": "quantity", "name": "Quantity", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true, "info": "Accelerated checkout buttons are enabled by default and their brand colors cannot be modified." }
      ]
    },
    {
      "type": "gift_card_recipient",
      "name": "Gift card recipient",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_recipient_form", "label": "Show recipient form for gift card products", "default": true },
        { "type": "text", "id": "recipient_label", "label": "Recipient form label", "default": "Send as a gift" }
      ]
    },
    { "type": "pickup_availability", "name": "Pickup availability", "limit": 1 },
    {
      "type": "follow_on_shop",
      "name": "Follow on Shop",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "enable_follow_on_shop", "label": "Enable Follow on Shop button", "default": true, "info": "The branded Follow on Shop button colors cannot be modified." }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and returns" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "page", "id": "page", "label": "Page", "info": "Displays the page content if no text is set." },
        { "type": "range", "id": "block_gap", "label": "Bottom spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1 },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid", "info": "Add app snippets or custom Liquid code. Acts as an insertion point for certain apps." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Product details",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "price" },
        { "type": "rating" },
        { "type": "variant_picker" },
        { "type": "selling_plans" },
        { "type": "quantity" },
        { "type": "buy_buttons" },
        { "type": "gift_card_recipient" },
        { "type": "pickup_availability" },
        { "type": "follow_on_shop" },
        { "type": "description" },
        { "type": "accordion", "settings": { "heading": "Shipping and returns", "block_gap": 14 } },
        { "type": "accordion", "settings": { "heading": "Materials", "block_gap": 14 } },
        { "type": "share" }
      ]
    }
  ]
}
