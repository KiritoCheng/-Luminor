{%- liquid
  assign product = product | default: section.settings.product | default: product
  assign current_variant = product.selected_or_first_available_variant
  assign show_thumbs = false
  if product.images.size > 1
    assign show_thumbs = true
  endif
  assign main_alt = product.featured_image.alt | default: product.title | escape
-%}

<section class="section" data-product-section>
  <div class="page-width">
    <div class="product">
      {%- comment -%} Media gallery {%- endcomment -%}
      <div class="product__media" data-product-gallery>
        <div class="product__media-main" data-product-main>
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 1600 | image_tag:
              loading: 'eager',
              widths: '375, 550, 750, 1100, 1500, 1780',
              sizes: '(max-width: 990px) 100vw, 50vw',
              alt: main_alt,
              data-image-id: product.featured_image.id }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product__placeholder' }}
          {%- endif -%}
        </div>

        {%- if show_thumbs -%}
          <div class="product__thumbs">
            {%- for image in product.images limit: 8 -%}
              <button class="product__thumb {% if forloop.first %}is-active{% endif %}" data-product-thumb data-main-url="{{ image | image_url: width: 1600 }}" data-image-id="{{ image.id }}">
                {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: image.alt | escape }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product info {%- endcomment -%}
      <div class="product__info">
        {%- if product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor | escape }}</p>
        {%- endif -%}

        <h1 class="product__title">{{ product.title | escape }}</h1>

        <div class="product__price" data-price>
          {% render 'price', product: product, variant: current_variant %}
        </div>
        <span data-compare-price hidden></span>

        {%- if product.metafields.reviews.rating.value != blank -%}
          <div class="product__rating">
            <span>{{ product.metafields.reviews.rating.value }} &#9733;</span>
            <span>({{ product.metafields.reviews.rating_count.value | default: 0 }})</span>
          </div>
        {%- endif -%}

        <div class="product__divider"></div>

        {%- form 'product', product, data-product-form: '', data-product-id: product.id -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- for option in product.options_with_values -%}
            <div class="product__option" data-option-group data-option-index="{{ forloop.index0 }}">
              <label class="product__option-label">{{ option.name | escape }}: <strong data-option-label>{{ option.selected_value | escape }}</strong></label>
              <div class="product__option-values">
                {%- for value in option.values -%}
                  {%- liquid
                    assign is_color = false
                    if option.name == 'Color' or option.name == 'Colour'
                      assign is_color = true
                    endif
                  -%}
                  <button type="button" class="product__option-value {% if is_color %}product__option-value--color{% endif %} {% if option.selected_value == value %}is-active{% endif %}"
                    data-option-value="{{ value | escape }}"
                    {% if is_color %}style="background-color: {{ value | split: ' ' | first | downcase }}"{% endif %}>
                    {%- unless is_color -%}{{ value | escape }}{%- endunless -%}
                    <span class="visually-hidden">{{ value | escape }}</span>
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <div class="product__qty">
            <label class="product__qty-label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
            <div class="qty-stepper">
              <button type="button" data-qty-step="down" aria-label="{{ 'products.product.quantity.decrease' | t }}">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" id="Quantity-{{ section.id }}" data-qty-input>
              <button type="button" data-qty-step="up" aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
            </div>
          </div>

          <div class="product__buy-buttons">
            <button type="submit" name="add" class="button button--secondary button--full button--lg"
              data-add-to-cart
              data-available="{{ 'products.product.add_to_cart' | t }}"
              data-sold-out="{{ 'products.product.sold_out' | t }}"
              {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
            {%- if section.settings.show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        <div class="product__accordion" data-accordion>
          {%- if product.metafields.product.details != blank -%}
            <details open>
              <summary>{{ 'products.product.details' | t }}</summary>
              <div class="accordion__content rte">{{ product.metafields.product.details }}</div>
            </details>
          {%- endif -%}
          <details>
            <summary>{{ 'products.product.shipping_returns' | t }}</summary>
            <div class="accordion__content">
              <p>{{ 'products.product.shipping_returns_text' | t }}</p>
            </div>
          </details>
          <details>
            <summary>{{ 'products.product.materials' | t }}</summary>
            <div class="accordion__content">
              {%- if product.metafields.product.materials != blank -%}
                {{ product.metafields.product.materials }}
              {%- else -%}
                <p>{{ 'products.product.materials_default' | t }}</p>
              {%- endif -%}
            </div>
          </details>
        </div>

        <p class="product__share color-muted">
          <a href="{{ product.url }}" class="link-arrow">{{ 'products.product.share' | t }}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-product-variants>
  {{ product.variants | json }}
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 200 | json }},
    {%- if product.featured_image -%}
      "image": ["https:{{ product.featured_image | image_url: width: 1200 }}"],
    {%- endif -%}
    "sku": {{ current_variant.sku | default: product.id | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: shop.name | json }}
    },
    "offers": {
      "@type": "Offer",
      "url": {{ canonical_url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | money_without_currency | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition"
    }
  }
</script>

<script>
  {%- comment -%} enrich variants with formatted price strings for JS {%- endcomment -%}
  window.productVariants = window.productVariants || [];
</script>

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky media on desktop",
      "default": true
    }
  ]
}
{% endschema %}
