    .anode-product__media-count { right: 10px; top: 10px; }
    .anode-product__thumbs { padding-inline: var(--page-width-padding, 20px); grid-template-columns: repeat(5, minmax(0, 1fr)); overflow-x: auto; scrollbar-width: none; }
