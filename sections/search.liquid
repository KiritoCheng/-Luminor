{%- liquid
  assign columns = section.settings.columns_desktop | default: 4
  assign filter_type = section.settings.filter_type | default: 'product'
-%}

<section class="section section--tight">
  <div class="page-width">
    <div class="collection-hero">
      <h1 class="collection-hero__title">{{ 'general.search.title' | t }}</h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter__form" style="max-width:560px;margin-bottom:32px;">
      <input type="hidden" name="type" value="{{ filter_type }}">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
      <button type="submit" class="button button--primary">{{ 'general.search.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      <div class="collection-layout">
        {%- comment -%} Facets sidebar {%- endcomment -%}
        <aside class="facets" data-facets>
          <div class="facets__header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <h2 style="font-size:1rem;font-weight:600;">{{ 'sections.collection_template.filter' | t }}</h2>
            <button class="facets__close" data-facets-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
          </div>
          <form id="FacetForm">
            {%- for filter in search.filters -%}
              <details class="facets__group" {% if filter.active_values.size > 0 %}open{% endif %}>
                <summary>{{ filter.label | escape }}</summary>
                <div class="facets__options">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      <div style="display:flex;gap:8px;">
                        <input type="number" name="{{ filter.min_value_param }}" value="{{ filter.min_value.value }}" placeholder="Min" aria-label="{{ 'sections.collection_template.min_price' | t | default: 'Minimum price' }}">
                        <input type="number" name="{{ filter.max_value_param }}" value="{{ filter.max_value.value }}" placeholder="Max" aria-label="{{ 'sections.collection_template.max_price' | t | default: 'Maximum price' }}">
                      </div>
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="checkbox">
                          <input type="checkbox" name="{{ value.param }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                          <span>{{ value.label | escape }} ({{ value.count }})</span>
                        </label>
                      {%- endfor -%}
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
            <noscript>
              <button type="submit" class="button button--primary button--full">{{ 'sections.collection_template.apply' | t }}</button>
            </noscript>
          </form>
        </aside>

        <div>
          <div class="collection-toolbar">
            <span class="collection-toolbar__count">{{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}</span>
            <div class="collection-toolbar__sort">
              <button class="collection-toolbar__filters-btn" data-facets-open>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                {{ 'sections.collection_template.filter' | t }}
              </button>
              {%- if search.sort_options.size > 0 -%}
                <form id="SortForm" method="get">
                  <input type="hidden" name="q" value="{{ search.terms | escape }}">
                  <input type="hidden" name="type" value="{{ filter_type }}">
                  <select name="sort_by" aria-label="{{ 'sections.collection_template.sort_by' | t }}">
                    {%- for option in search.sort_options -%}
                      <option value="{{ option.value }}" {% if option.value == search.sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
                    {%- endfor -%}
                  </select>
                </form>
              {%- endif -%}
            </div>
          </div>

          <div id="SearchResults">
            {%- paginate search.results by 24 -%}
              {%- if search.results.size > 0 -%}
                <div class="product-grid" style="--cols: {{ columns }}">
                  {%- for item in search.results -%}
                    {%- if item.object_type == 'product' -%}
                      <div class="reveal">{% render 'product-card', product: item %}</div>
                    {%- else -%}
                      <a href="{{ item.url }}" class="product-card">
                        <div class="product-card__media">
                          {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
                        </div>
                        <h2 class="product-card__title">{{ item.title | escape }}</h2>
                        <p class="product-card__vendor">{{ item.object_type | capitalize }}</p>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {% render 'pagination', paginate: paginate %}
              {%- else -%}
                <p class="color-muted">{{ 'general.search.no_matches' | t }}</p>
              {%- endif -%}
            {%- endpaginate -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('FacetForm');
    if (form) {
      form.addEventListener('change', function () {
        var params = new URLSearchParams(window.location.search);
        var formData = new FormData(form);
        for (var pair of formData.entries()) {
          if (pair[1]) params.set(pair[0], pair[1]);
          else params.delete(pair[0]);
        }
        window.location.search = params.toString();
      });
    }
    var sortForm = document.getElementById('SortForm');
    if (sortForm) {
      sortForm.addEventListener('change', function (e) {
        var params = new URLSearchParams(window.location.search);
        params.set('sort_by', e.target.value);
        window.location.search = params.toString();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "filter_type",
      "label": "Search type for filtering",
      "options": [
        { "value": "product", "label": "Product" },
        { "value": "article,page", "label": "Article and page" }
      ],
      "default": "product"
    }
  ]
}
{% endschema %}
