<div class="spacer" style="height: {{ section.settings.height }}px;" data-spacer></div>

{% schema %}
{
  "name": "Spacer",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Height",
      "default": 48
    }
  ],
  "presets": [ { "name": "Spacer" } ]
}
{% endschema %}
