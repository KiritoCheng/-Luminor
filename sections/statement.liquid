{%- comment -%}
  Statement — full-bleed 品牌冲击章节,装饰性巨字水印 + 单句宣言。
  用于打破首页节奏,提供视觉锚点。
  Signature moment: scroll-driven word-by-word reveal on heading.
{%- endcomment -%}

{%- liquid
  # Typography clamp pipeline (px → rem, then vw blended inside clamp via CSS variable)
  assign h_mob  = section.settings.heading_mobile  | default: 40 | times: 0.0625
  assign h_dsk  = section.settings.heading_desktop | default: 80 | times: 0.0625
  assign t_mob  = section.settings.text_mobile     | default: 16 | times: 0.0625
  assign t_dsk  = section.settings.text_desktop    | default: 20 | times: 0.0625
  assign h_wt   = section.settings.heading_weight
  assign h_trk  = section.settings.heading_tracking
  assign h_ld   = section.settings.heading_leading
  assign t_wt   = section.settings.text_weight
  assign e_wt   = section.settings.eyebrow_weight
  assign bg_c   = section.settings.bg_color        | default: '#111114'
  assign e_c    = section.settings.eyebrow_color   | default: '#A78BFA'
  assign h_c    = section.settings.heading_color   | default: '#FFFFFF'
  assign t_c    = section.settings.text_color      | default: '#FFFFFF'
  assign cta_b  = section.settings.cta_bg          | default: '#FFFFFF'
  assign cta_t  = section.settings.cta_text        | default: '#0a0a0c'
-%}
<section class="section--flush statement reveal" data-statement
  style="
    --st-bg-color:       {{ bg_c }};
    --st-eyebrow-color:  {{ e_c }};
    --st-eyebrow-weight: {{ e_wt }};
    --st-h-fs:           clamp({{ h_mob }}rem, 6vw, {{ h_dsk }}rem);
    --st-h-weight:       {{ h_wt }};
    --st-h-leading:      {{ h_ld }};
    --st-h-tracking:     {{ h_trk }};
    --st-h-color:        {{ h_c }};
    --st-text-fs:        clamp({{ t_mob }}rem, 1.5vw, {{ t_dsk }}rem);
    --st-text-weight:    {{ t_wt }};
    --st-text-color:     {{ t_c }};
    --st-cta-bg:         {{ cta_b }};
    --st-cta-text:       {{ cta_t }};
    background-color:    {{ bg_c }};
    color:               {{ h_c }};
  ">
    <div class="statement__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow statement__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      {%- assign words = section.settings.heading | split: ' ' -%}
      <h2 class="statement__heading" data-statement-heading>
        {%- for word in words -%}
          <span class="statement__word" aria-hidden="true">{{ word }}</span>
        {%- endfor -%}
        <span class="sr-only">{{ section.settings.heading | escape }}</span>
      </h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="statement__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="button button--primary button--lg statement__cta">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  function initStatementReveal() {
    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    document.querySelectorAll('[data-statement]').forEach(function (section) {
      var heading = section.querySelector('[data-statement-heading]');
      if (!heading) return;
      var words = heading.querySelectorAll('.statement__word');
      if (!words.length) return;

      function update() {
        var rect = section.getBoundingClientRect();
        var vh = window.innerHeight;
        // Progress: 0 when section bottom enters viewport, 1 when section top passes center
        var start = vh * 0.9;
        var end = -rect.height * 0.3;
        var progress = (start - rect.top) / (start - end);
        progress = Math.max(0, Math.min(1, progress));

        var total = words.length;
        // Each word reveals in sequence across the progress range
        var window_size = 0.6; // words reveal within 60% of the scroll range
        words.forEach(function (word, i) {
          var wordProgress = (progress - (i / total) * (1 - window_size)) / window_size;
          wordProgress = Math.max(0, Math.min(1, wordProgress));
          // ease-out
          var eased = 1 - Math.pow(1 - wordProgress, 3);
          word.style.opacity = (0.12 + eased * 0.88).toFixed(3);
          word.style.transform = 'translateY(' + ((1 - eased) * 0.18).toFixed(3) + 'em)';
        });
      }

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatementReveal);
  } else {
    initStatementReveal();
  }
  document.addEventListener('shopify:section:load', initStatementReveal);
})();
</script>

{% schema %}{
  "name": "Statement",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every detail. Considered."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body",
      "default": "<p>Every material chosen with intent. Every detail obsessed over. Thoughtfully designed to accompany the things that matter for a lifetime.</p>"
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "min": 32, "max": 64, "step": 2, "unit": "px",
      "label": "Heading size — Mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_desktop",
      "min": 56, "max": 104, "step": 2, "unit": "px",
      "label": "Heading size — Desktop",
      "default": 80
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "heading_tracking",
      "label": "Letter spacing",
      "options": [
        { "value": "-0.04em", "label": "Very tight" },
        { "value": "-0.03em", "label": "Tight" },
        { "value": "-0.02em", "label": "Normal" },
        { "value": "-0.01em", "label": "Relaxed" }
      ],
      "default": "-0.03em"
    },
    {
      "type": "select",
      "id": "heading_leading",
      "label": "Line height",
      "options": [
        { "value": "0.98", "label": "Compact" },
        { "value": "1.05", "label": "Balanced" },
        { "value": "1.12", "label": "Relaxed" },
        { "value": "1.20", "label": "Airy" }
      ],
      "default": "1.05"
    },
    {
      "type": "header",
      "content": "Body typography"
    },
    {
      "type": "range",
      "id": "text_mobile",
      "min": 13, "max": 20, "step": 1, "unit": "px",
      "label": "Body size — Mobile",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_desktop",
      "min": 16, "max": 24, "step": 1, "unit": "px",
      "label": "Body size — Desktop",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Body weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Eyebrow weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#111114"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#A78BFA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body color",
      "default": "#FFFFFF"
    },
    {
