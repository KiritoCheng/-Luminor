{%- comment -%}
  Statement — full-bleed 品牌冲击章节,装饰性巨字水印 + 单句宣言。
  用于打破首页节奏,提供视觉锚点。
  Signature moment: scroll-driven word-by-word reveal on heading.
{%- endcomment -%}

<section class="section--flush statement reveal" data-statement
  style="background-color: var(--color-bg-dark); color: var(--color-text-invert);">
  {%- if section.settings.watermark != blank -%}
    <span class="statement__watermark" aria-hidden="true" data-parallax>{{ section.settings.watermark | escape }}</span>
  {%- endif -%}
  <div class="statement__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow statement__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      {%- assign words = section.settings.heading | split: ' ' -%}
      <h2 class="statement__heading" data-statement-heading>
        {%- for word in words -%}
          <span class="statement__word" aria-hidden="true">{{ word }}</span>
        {%- endfor -%}
        <span class="sr-only">{{ section.settings.heading | escape }}</span>
      </h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="statement__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="button button--primary button--lg statement__cta">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  function initStatementReveal() {
    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    document.querySelectorAll('[data-statement]').forEach(function (section) {
      var heading = section.querySelector('[data-statement-heading]');
      if (!heading) return;
      var words = heading.querySelectorAll('.statement__word');
      if (!words.length) return;

      function update() {
        var rect = section.getBoundingClientRect();
        var vh = window.innerHeight;
        // Progress: 0 when section bottom enters viewport, 1 when section top passes center
        var start = vh * 0.9;
        var end = -rect.height * 0.3;
        var progress = (start - rect.top) / (start - end);
        progress = Math.max(0, Math.min(1, progress));

        var total = words.length;
        // Each word reveals in sequence across the progress range
        var window_size = 0.6; // words reveal within 60% of the scroll range
        words.forEach(function (word, i) {
          var wordProgress = (progress - (i / total) * (1 - window_size)) / window_size;
          wordProgress = Math.max(0, Math.min(1, wordProgress));
          // ease-out
          var eased = 1 - Math.pow(1 - wordProgress, 3);
          word.style.opacity = (0.12 + eased * 0.88).toFixed(3);
          word.style.transform = 'translateY(' + ((1 - eased) * 0.18).toFixed(3) + 'em)';
        });
      }

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatementReveal);
  } else {
    initStatementReveal();
  }
  document.addEventListener('shopify:section:load', initStatementReveal);
})();
</script>

{% schema %}{
  "name": "Statement",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "watermark",
      "label": "Watermark text",
      "default": "LUMINOR"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed in California. Assembled with intent."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every detail considered. Every material chosen for a reason. Built for the Apple ecosystem, obsessed over for a lifetime.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Statement",
      "settings": {
        "heading": "Apple Authorized selection. Boutique service."
      }
    }
  ]
}{% endschema %}
