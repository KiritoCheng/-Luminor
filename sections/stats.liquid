{%- comment -%}
  Stats — full-bleed 深色数字计数章节。
  数字随滚动进入视口时从 0 滚到目标值(initCountUp 在 theme.js)。
{%- endcomment -%}

<section class="section--flush stats reveal"
  style="background-color: var(--color-bg-dark); color: var(--color-text-invert);">
  {%- if section.settings.watermark != blank -%}
    <span class="stats__watermark" aria-hidden="true" data-parallax>{{ section.settings.watermark | escape }}</span>
  {%- endif -%}
  <div class="stats__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow stats__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="stats__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="stats__grid stagger" style="--stats-cols: {{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="stats__item" {{ block.shopify_attributes }}>
          <span class="stats__number" data-count="{{ block.settings.number | escape }}" data-suffix="{{ block.settings.suffix | escape }}" data-prefix="{{ block.settings.prefix | escape }}">0{{ block.settings.suffix | escape }}</span>
          <span class="stats__label">{{ block.settings.label | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .stats { position: relative; overflow: hidden; padding-block: clamp(72px, 10vw, 120px); }
  .stats__watermark { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: clamp(6rem, 18vw, 16rem); font-weight: 700; letter-spacing: -0.06em; color: var(--color-text-invert); opacity: 0.04; pointer-events: none; white-space: nowrap; will-change: transform; }
  .stats__inner { position: relative; z-index: 1; text-align: center; }
  .stats__eyebrow { color: var(--color-text-invert); opacity: 0.7; }
  .stats__eyebrow::before { background-color: var(--color-text-invert); opacity: 0.5; }
  .stats__heading { font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 600; letter-spacing: -0.03em; color: var(--color-text-invert); margin-bottom: 56px; text-wrap: balance; overflow-wrap: break-word; }
  .stats__grid { display: grid; grid-template-columns: repeat(var(--stats-cols, 3), 1fr); gap: 32px; }
  .stats__item { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .stats__number { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1; color: var(--color-text-invert); font-variant-numeric: tabular-nums; overflow-wrap: break-word; }
  .stats__label { font-size: 0.875rem; color: var(--color-text-invert); opacity: 0.65; letter-spacing: -0.01em; }
  @media (max-width: 749px) { .stats__grid { grid-template-columns: 1fr; gap: 40px; } }
  @media (prefers-reduced-motion: reduce) { .stats__watermark { display: none; } }
</style>

{% schema %}
{
  "name": "Stats counter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "watermark", "label": "Watermark text", "default": "LUMINOR" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "By the numbers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted worldwide" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "120" },
        { "type": "text", "id": "prefix", "label": "Prefix" },
        { "type": "text", "id": "suffix", "label": "Suffix" },
        { "type": "text", "id": "label", "label": "Label", "default": "Creators equipped" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats counter",
      "blocks": [
        { "type": "stat", "settings": { "number": "120", "suffix": "K+", "label": "Creators equipped" } },
        { "type": "stat", "settings": { "number": "48", "label": "Countries shipped" } },
        { "type": "stat", "settings": { "number": "4.9", "suffix": "★", "label": "Average rating" } }
      ]
    }
  ]
}
{% endschema %}
