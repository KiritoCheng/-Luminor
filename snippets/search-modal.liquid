{%- comment -%}
  Search modal — rendered by layout/theme.liquid.
{%- endcomment -%}
<div class="search-modal" data-search-modal aria-hidden="true">
  <div class="search-modal__header">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form" style="flex:1; display:flex; gap:12px;">
      <input type="search" name="q" class="search-modal__input" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" aria-label="{{ 'general.search.search' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="visually-hidden">{{ 'general.search.search' | t }}</button>
    </form>
    <button class="search-modal__close" data-search-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon-close' %}
    </button>
  </div>
  <div class="search-modal__body">
    <div class="predictive-results" data-predictive-results>
      <p class="color-muted">{{ 'general.search.start_typing' | t }}</p>
    </div>
  </div>
</div>
