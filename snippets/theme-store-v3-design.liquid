{%- comment -%}
  Theme Store v3 visual layer.
  Loaded from the product card so it remains compatible with the existing
  Shopify section architecture without changing merchant editor structure.
{%- endcomment -%}
<style>
  :root {
    --v3-content-width: min(1320px, calc(100vw - 48px));
    --v3-section-space: clamp(64px, 8vw, 120px);
    --v3-section-space-sm: clamp(48px, 10vw, 72px);
    --v3-grid-gap: clamp(16px, 2vw, 28px);
    --v3-radius: clamp(12px, 1.4vw, 20px);
    --v3-border: color-mix(in srgb, var(--color-text) 10%, transparent);
    --v3-muted: color-mix(in srgb, var(--color-text) 62%, transparent);
  }

  body {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  #MainContent > .shopify-section:not(:first-child) {
    border-top: 1px solid var(--v3-border);
  }

  #MainContent .section-header,
  #MainContent .section-heading,
  #MainContent .section-title {
    max-width: var(--v3-content-width);
    margin-inline: auto;
  }

  #MainContent .section-header {
    margin-bottom: clamp(28px, 4vw, 52px);
  }

  #MainContent .section-header h2,
  #MainContent .section-heading h2,
  #MainContent .section-title {
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  #MainContent .section:not(.section--flush),
  #MainContent .featured-collection,
  #MainContent .category-pills,
  #MainContent .lookbook,
  #MainContent .home-search,
  #MainContent .home-quick-links,
  #MainContent .statement,
  #MainContent .press,
  #MainContent .image-with-text,
  #MainContent .home-popular-collections {
    padding-block: var(--v3-section-space);
  }

  /* Homepage: make the hero the visual anchor instead of another generic block. */
  .template-index .hero-section {
    min-height: min(760px, calc(100svh - 60px));
  }

  .template-index .hero-section .hero__content {
    max-width: min(760px, 78vw);
  }

  .template-index .hero-section .hero__heading,
  .template-index .hero-section h1 {
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .template-index .hero-section .hero__cta {
    gap: 12px;
  }

  .template-index .hero-section .hero__cta a {
    min-height: 48px;
    padding-inline: 22px;
  }

  /* Keep social proof quiet so it supports the product story rather than competing with it. */
  .template-index .stats {
    background: var(--color-bg-alt);
  }

  .template-index .press {
    background: var(--color-bg-alt);
  }

  /* Product grids: calmer, more premium rhythm. */
  #MainContent .featured-collection__grid,
  #MainContent .collection-product-grid,
  #MainContent .product-grid {
    column-gap: var(--v3-grid-gap);
    row-gap: clamp(36px, 4vw, 64px);
  }

  /* Product cards: visual hierarchy instead of UI chrome. */
  #MainContent .product-card__media {
    border-radius: var(--v3-radius);
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  #MainContent .product-card__actions {
    gap: 8px;
  }

  #MainContent .product-card__action-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
  }

  #MainContent .product-card__info {
    padding-inline: 0;
  }

  #MainContent .product-card__vendor {
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 7px;
  }

  #MainContent .product-card__title {
    font-size: clamp(0.9375rem, 1vw, 1.0625rem);
    line-height: 1.3;
    margin-bottom: 7px;
  }

  #MainContent .product-card__price {
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  #MainContent .badge {
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #MainContent input,
  #MainContent select,
  #MainContent textarea,
  #MainContent button {
    font: inherit;
  }

  #MainContent input:not([type='checkbox']):not([type='radio']),
  #MainContent select,
  #MainContent textarea {
    border-radius: max(8px, var(--button-radius));
  }

  #MainContent a:focus-visible,
  #MainContent button:focus-visible,
  #MainContent input:focus-visible,
  #MainContent select:focus-visible,
  #MainContent textarea:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    #MainContent *,
    #MainContent *::before,
    #MainContent *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (max-width: 749px) {
    :root {
      --v3-content-width: calc(100vw - 32px);
    }

    #MainContent .section:not(.section--flush),
    #MainContent .featured-collection,
    #MainContent .category-pills,
    #MainContent .lookbook,
    #MainContent .home-search,
    #MainContent .home-quick-links,
    #MainContent .statement,
    #MainContent .press,
    #MainContent .image-with-text,
    #MainContent .home-popular-collections {
      padding-block: var(--v3-section-space-sm);
    }

    #MainContent .product-card__actions {
      opacity: 1;
      transform: none;
    }

    #MainContent .product-card__action-btn {
      width: 40px;
      height: 40px;
    }

    .template-index .hero-section {
      min-height: min(680px, calc(100svh - 52px));
    }

    .template-index .hero-section .hero__content {
      max-width: calc(100vw - 32px);
    }

    .template-index .hero-section .hero__cta {
      flex-wrap: wrap;
    }
  }
</style>
