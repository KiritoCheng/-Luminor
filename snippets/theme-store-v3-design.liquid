{%- comment -%}
  ANODE visual system v2.
  Art direction: precision editorial — quiet surfaces, measured grid lines,
  indexed product information, and strong typographic hierarchy.
{%- endcomment -%}
<style>
  :root {
    --anode-content-width: min(1320px, calc(100vw - 48px));
    --anode-section-space: clamp(72px, 9vw, 132px);
    --anode-section-space-sm: clamp(52px, 11vw, 76px);
    --anode-grid-gap: clamp(16px, 2vw, 28px);
    --anode-radius: clamp(12px, 1.2vw, 18px);
    --anode-line: color-mix(in srgb, var(--color-text) 11%, transparent);
    --anode-muted: color-mix(in srgb, var(--color-text) 60%, transparent);
    --anode-accent: var(--color-primary, #4f46e5);
  }

  body {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* ANODE signature: a restrained technical grid used as a structural cue. */
  #MainContent {
    background-image: linear-gradient(to right, var(--anode-line) 1px, transparent 1px);
    background-size: max(100vw / 12, 120px) 100%;
    background-position: center top;
  }

  #MainContent > .shopify-section:not(:first-child) {
    border-top: 1px solid var(--anode-line);
  }

  #MainContent .page-width {
    max-width: var(--anode-content-width);
  }

  #MainContent .section-header,
  #MainContent .section-heading,
  #MainContent .section-title {
    max-width: var(--anode-content-width);
    margin-inline: auto;
  }

  #MainContent .section-header {
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  #MainContent .section-header h2,
  #MainContent .section-heading h2,
  #MainContent .section-title,
  #MainContent .featured-collection__title {
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  #MainContent .section:not(.section--flush),
  #MainContent .featured-collection,
  #MainContent .category-pills,
  #MainContent .lookbook,
  #MainContent .home-search,
  #MainContent .home-quick-links,
  #MainContent .statement,
  #MainContent .press,
  #MainContent .image-with-text,
  #MainContent .home-popular-collections {
    padding-block: var(--anode-section-space);
  }

  #MainContent .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--anode-muted);
  }

  #MainContent .eyebrow::before {
    content: '';
    width: 22px;
    height: 1px;
    background: currentColor;
  }

  #MainContent .featured-collection__grid,
  #MainContent .collection-product-grid,
  #MainContent .product-grid {
    column-gap: var(--anode-grid-gap);
    row-gap: clamp(40px, 5vw, 72px);
  }

  #MainContent .product-card {
    position: relative;
  }

  #MainContent .product-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--anode-radius);
    background: var(--color-bg-alt, #f6f6f8);
    isolation: isolate;
  }

  /* A quiet vertical mark becomes a repeatable Anode product signature. */
  #MainContent .product-card__media::after {
    content: '';
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 1px;
    height: 24px;
    background: color-mix(in srgb, var(--color-text) 32%, transparent);
    z-index: 2;
    pointer-events: none;
  }

  #MainContent .product-card__actions {
    gap: 8px;
  }

  #MainContent .product-card__action-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    box-shadow: var(--shadow-sm, 0 4px 18px rgba(0,0,0,.12));
  }

  #MainContent .product-card__info {
    position: relative;
    padding: 14px 0 0 28px;
  }

  #MainContent .product-card__info::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 17px;
    bottom: 0;
    width: 1px;
    background: var(--anode-line);
  }

  #MainContent .product-card__vendor {
    margin-bottom: 7px;
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--anode-muted);
  }

  #MainContent .product-card__title {
    margin-bottom: 8px;
    font-size: clamp(0.9375rem, 1vw, 1.0625rem);
    line-height: 1.3;
  }

  #MainContent .product-card__price {
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  #MainContent .badge {
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #MainContent input,
  #MainContent select,
  #MainContent textarea,
  #MainContent button {
    font: inherit;
  }

  #MainContent input:not([type='checkbox']):not([type='radio']),
  #MainContent select,
  #MainContent textarea {
    border-radius: max(8px, var(--button-radius, 8px));
  }

  #MainContent a:focus-visible,
  #MainContent button:focus-visible,
  #MainContent input:focus-visible,
  #MainContent select:focus-visible,
  #MainContent textarea:focus-visible {
    outline: 2px solid var(--anode-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    #MainContent *,
    #MainContent *::before,
    #MainContent *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (max-width: 749px) {
    :root {
      --anode-content-width: calc(100vw - 32px);
    }

    #MainContent {
      background-size: 50% 100%;
    }

    #MainContent .section:not(.section--flush),
    #MainContent .featured-collection,
    #MainContent .category-pills,
    #MainContent .lookbook,
    #MainContent .home-search,
    #MainContent .home-quick-links,
    #MainContent .statement,
    #MainContent .press,
    #MainContent .image-with-text,
    #MainContent .home-popular-collections {
      padding-block: var(--anode-section-space-sm);
    }

    #MainContent .product-card__actions {
      opacity: 1;
      transform: none;
    }

    #MainContent .product-card__action-btn {
      width: 40px;
      height: 40px;
    }

    #MainContent .product-card__info {
      padding-left: 22px;
    }

    #MainContent .product-card__info::before {
      left: 7px;
    }
  }
</style>
