{% comment %}
  Contact page template — Apple/Awwwards redesign.
  Structure:
    1. hero banner (statements section-style, gradient bg + blur halo)
    2. contact section 2-col: info cards (email/chat/hours/address) + glassm form
    3. FAQ preview (3 common Qs) → link /pages/faq
    4. newsletter CTA (Luminor circle reuse)
{% endcomment %}

{# ══════════════════════════════════════════════════════════ #}
{#  1.  HERO / INTRO BANNER                                    #}
{# ══════════════════════════════════════════════════════════ #}
<section class="contact-hero reveal">
  <div class="contact-hero__bg" aria-hidden="true"></div>
  <div class="contact-hero__halo" aria-hidden="true"></div>
  <div class="page-width contact-hero__inner">
    <p class="contact-hero__eyebrow">Contact</p>
    <h1 class="contact-hero__title">Let's make<br>something great.</h1>
    <p class="contact-hero__lead">
      We read every message — whether you need sizing help, warranty support,
      or just want to talk titanium grade. Expect a reply within 24 hours.
    </p>
    <div class="contact-hero__channels">
      <a class="channel-pill" href="mailto:support@luminor-theme.com">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="m22 6-10 7L2 6"/></svg>
        <span>Email support</span>
      </a>
      <a class="channel-pill" href="/pages/faq">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
        <span>Browse FAQs</span>
      </a>
      <a class="channel-pill" href="tel:+18000000000">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.1 9.91a16 16 0 0 0 6 6l1.27-1.26a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
        <span>Call us</span>
      </a>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════ #}
{#  2.  CONTACT MAIN: INFO GRID + FORM                        #}
{# ══════════════════════════════════════════════════════════ #}
<section class="section section--tight contact-main">
  <div class="page-width contact-main__grid">
    {% comment %} LEFT: info cards {% endcomment %}
    <div class="contact-info">
      <p class="contact-info__eyebrow">Ways to reach us</p>
      <h2 class="contact-info__title">Pick your channel.</h2>
      <p class="contact-info__sub color-muted">
        Mon–Fri, 9:00 AM – 6:00 PM EST. Weekend tickets answered Monday morning.
      </p>

      <ul class="info-cards">
        <li class="info-card">
          <div class="info-card__icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="m22 6-10 7L2 6"/></svg>
          </div>
          <div>
            <h3>Email</h3>
            <a href="mailto:support@luminor-theme.com">support@luminor-theme.com</a>
            <p>Usually replies within 4 hours.</p>
          </div>
        </li>
        <li class="info-card">
          <div class="info-card__icon info-card__icon--green">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
          </div>
          <div>
            <h3>Live chat</h3>
            <a href="#" onclick="return confirm('Chat widget coming soon.');">Chat with team →</a>
            <p>Instant replies during business hours.</p>
          </div>
        </li>
        <li class="info-card">
          <div class="info-card__icon info-card__icon--purple">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <div>
            <h3>Business hours</h3>
            <span>Mon–Fri · 9am–6pm EST</span>
            <p>Weekend support via email only.</p>
          </div>
        </li>
        <li class="info-card">
          <div class="info-card__icon info-card__icon--orange">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h3>Studio (HQ)</h3>
            <span>Remote · Serving 40+ countries</span>
            <p>For partnerships: hello@luminor-theme.com</p>
          </div>
        </li>
      </ul>
    </div>

    {% comment %} RIGHT: contact form (glassmorphic card) {% endcomment %}
    <div class="contact-form-wrap reveal" id="contact-form-card">
      <div class="contact-form-card">
        <div class="contact-form-card__head">
          <p class="contact-form-card__eyebrow">Message</p>
          <h3>Send us a note.</h3>
          <p class="color-muted">Tell us about your setup — size, device, what you need.</p>
        </div>

        {%- form 'contact', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="contact-form__success" role="status">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <div>
                <strong>Message sent.</strong>
                <span>We'll reply as soon as possible.</span>
              </div>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="contact-form__errors" role="alert">
              <h4>{{ 'sections.contact_form.error_heading' | t }}</h4>
              <ul>
                {%- if form.errors.translated_fields -%}
                  {%- assign error_fields = form.errors.translated_fields -%}
                  {%- assign error_messages = form.errors.messages -%}
                  {%- for i in (0..error_fields.size) -%}
                    {%- assign field = error_fields[i] -%}
                    {%- if field and field != 'form' -%}
                      <li>{{ field | capitalize }} — {{ error_messages[i] | escape }}</li>
                    {%- elsif field == 'form' -%}
                      <li>{{ error_messages[i] | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact-form__row">
            <label class="field">
              <span class="field__label">Name</span>
              <input
                type="text"
                name="contact[name]"
                required
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                {% if form.errors contains 'name' %}aria-invalid="true"{% endif %}>
            </label>
            <label class="field">
              <span class="field__label">Email <em>*</em></span>
              <input
                type="email"
                name="contact[email]"
                required
                autocomplete="email"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
            </label>
          </div>

          <label class="field" style="margin-top:18px">
            <span class="field__label">Subject</span>
            <select name="contact[subject]">
              <option>General inquiry</option>
              <option>Order &amp; shipping</option>
              <option>Returns &amp; warranty</option>
              <option>Partnerships &amp; press</option>
              <option>Other</option>
            </select>
          </label>

          <label class="field field--textarea" style="margin-top:18px">
            <span class="field__label">Message <em>*</em></span>
            <textarea
              name="contact[body]"
              rows="6"
              required
              placeholder="Tell us about your Luminor product, your device, or the problem you're solving..."
              {% if form.errors contains 'body' %}aria-invalid="true"{% endif %}
            >{{ form.body }}</textarea>
          </label>

          <button type="submit" class="contact-form__submit">
            <span>Send message</span>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{# ══════════════════════════════════════════════════════════ #}
{#  3.  FAQ PREVIEW — 3 common questions                      #}
{# ══════════════════════════════════════════════════════════ #}
<section class="section bg-alt contact-faq">
  <div class="page-width page-width--narrow">
    <div style="text-align:center;">
      <p class="eyebrow">Help center</p>
      <h2 style="margin-top:10px">Quick answers, first.</h2>
      <p class="lead color-muted" style="margin-top:14px;max-width:620px;margin-inline:auto;">
        80% of support questions are already answered below. Can't find yours?
        Use the form above — we're here.
      </p>
    </div>
    <ul class="faq-preview">
      <li class="faq-preview__item">
        <h3>How long does shipping take?</h3>
        <p>3–5 business days within the US. International orders 7–14 days depending on destination and customs. Expedited shipping available at checkout.</p>
      </li>
      <li class="faq-preview__item">
        <h3>Can I return within 30 days?</h3>
        <p>Yes. All Luminor products are backed by our 30-day promise. Return them in original condition for a full refund, no questions asked.</p>
      </li>
      <li class="faq-preview__item">
        <h3>Are Luminor accessories MagSafe compatible?</h3>
        <p>Every magnetic mount, wallet and case in our catalog is tested and certified for full MagSafe strength on iPhone 12 and newer.</p>
      </li>
    </ul>
    <div style="text-align:center;margin-top:36px;">
      <a class="button button--secondary" href="/pages/faq">See all FAQs</a>
    </div>
  </div>
</section>

<style>
/* ---------- CONTACT: GLOBAL ---------- */
:root {
  --contact-primary: #0071e3;
  --contact-primary-hover: #0077ed;
  --contact-card-bg: rgba(255, 255, 255, 0.62);
  --contact-card-border: rgba(0,0,0,0.07);
}

/* ---------- CONTACT: HERO ---------- */
.contact-hero {
  position: relative;
  overflow: hidden;
  padding: clamp(56px, 8vw, 108px) 0 clamp(52px, 7vw, 88px);
  isolation: isolate;
}
.contact-hero__bg {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(1200px 600px at 85% -10%, color-mix(in srgb, var(--color-primary, #0071e3) 20%, transparent), transparent 60%),
    radial-gradient(900px 500px at -10% 110%, color-mix(in srgb, #7c3aed 16%, transparent), transparent 60%),
    linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
}
.contact-hero__halo {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(closest-side, color-mix(in srgb, var(--color-primary, #0071e3) 14%, transparent), transparent 70%) 50% 50% / 80% 80% no-repeat;
  filter: blur(38px);
  opacity: 0.65;
  pointer-events: none;
  animation: contactHaloFloat 14s ease-in-out infinite alternate;
}
@keyframes contactHaloFloat {
  0%   { transform: translate3d(0,0,0) scale(1);    opacity: 0.55; }
  100% { transform: translate3d(0,-18px,0) scale(1.05); opacity: 0.8; }
}
@media (prefers-reduced-motion: reduce) {
  .contact-hero__halo { animation: none; }
}

.contact-hero__inner { max-width: 820px; text-align: center; }
.contact-hero__eyebrow {
  font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.12em; color: var(--color-primary);
  margin: 0 0 16px;
}
.contact-hero__title {
  font-size: clamp(2.4rem, 6vw, 4.4rem);
  font-weight: 700; letter-spacing: -0.032em; line-height: 1.02;
  margin: 0;
  background: linear-gradient(180deg, var(--color-text) 0%, color-mix(in srgb, var(--color-text) 68%, var(--color-primary)) 100%);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.contact-hero__lead {
  margin: 22px auto 0;
  max-width: 620px;
  font-size: clamp(0.95rem, 1.2vw, 1.08rem);
  line-height: 1.55; color: var(--color-text-muted);
}
.contact-hero__channels {
  margin-top: 34px;
  display: inline-flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}
.channel-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 18px;
  border-radius: 100px;
  border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
  background: color-mix(in srgb, var(--color-bg) 70%, transparent);
  backdrop-filter: blur(14px) saturate(180%);
  -webkit-backdrop-filter: blur(14px) saturate(180%);
  color: var(--color-text); text-decoration: none;
  font-size: 0.8125rem; font-weight: 500;
  transition: transform 0.25s var(--ease-spring, cubic-bezier(.2,.8,.2,1)),
              background-color 0.2s ease,
              border-color 0.2s ease,
              color 0.2s ease,
              box-shadow 0.25s ease;
}
.channel-pill:hover {
  transform: translateY(-1px);
  border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
  color: var(--color-primary);
  box-shadow: 0 10px 26px -12px color-mix(in srgb, var(--color-primary) 40%, transparent);
  background: color-mix(in srgb, var(--color-primary) 6%, var(--color-bg));
}
.channel-pill:active { transform: translateY(0) scale(0.985); }

/* ---------- CONTACT: MAIN GRID ---------- */
.contact-main { padding-top: clamp(28px, 4vw, 56px); }
.contact-main__grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(28px, 4.2vw, 56px);
  align-items: start;
}
@media (max-width: 900px) {
  .contact-main__grid { grid-template-columns: 1fr; }
}

/* Left info column */
.contact-info { padding: 18px 6px 0; }
.contact-info__eyebrow {
  font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.12em; color: var(--color-primary); margin: 0 0 14px;
}
.contact-info__title {
  font-size: clamp(1.75rem, 3vw, 2.4rem);
  font-weight: 700; letter-spacing: -0.025em; line-height: 1.1;
  margin: 0 0 14px;
}
.contact-info__sub {
  font-size: 0.95rem; line-height: 1.6; margin: 0 0 32px; max-width: 420px;
}
.info-cards { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
.info-card {
  display: flex; align-items: flex-start; gap: 16px;
  padding: 18px 18px 18px 16px;
  border-radius: 18px;
  border: 1px solid color-mix(in srgb, var(--color-text) 7%, transparent);
  background: color-mix(in srgb, var(--color-bg) 60%, transparent);
  transition: transform 0.3s var(--ease-spring, cubic-bezier(.2,.8,.2,1)),
              border-color 0.25s ease, background-color 0.25s ease,
              box-shadow 0.35s ease;
}
.info-card:hover {
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
  background: color-mix(in srgb, var(--color-primary) 3.5%, var(--color-bg));
  box-shadow: 0 18px 36px -22px color-mix(in srgb, var(--color-primary) 45%, transparent);
}
.info-card__icon {
  flex-shrink: 0;
  width: 42px; height: 42px;
  border-radius: 12px;
  display: inline-flex; align-items: center; justify-content: center;
  background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  color: var(--color-primary);
}
.info-card__icon--green  { background: color-mix(in srgb, #22c55e 16%, transparent); color: #16a34a; }
.info-card__icon--purple { background: color-mix(in srgb, #7c3aed 16%, transparent); color: #6d28d9; }
.info-card__icon--orange { background: color-mix(in srgb, #f59e0b 16%, transparent); color: #d97706; }
.info-card h3 {
  font-size: 0.9375rem; font-weight: 600; margin: 0 0 4px; letter-spacing: -0.01em;
}
.info-card a,
.info-card span {
  display: inline-block;
  font-size: 0.85rem; font-weight: 500; color: var(--color-primary);
  text-decoration: none;
}
.info-card span { color: var(--color-text); }
.info-card a:hover { text-decoration: underline; }
.info-card p {
  font-size: 0.78rem; color: var(--color-text-muted); line-height: 1.45; margin: 4px 0 0;
}

/* Right form column */
.contact-form-card {
  position: relative;
  padding: clamp(24px, 3vw, 36px);
  border-radius: 24px;
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--color-bg) 86%, transparent) 0%, color-mix(in srgb, var(--color-bg) 78%, transparent) 100%);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
  box-shadow:
    0 1px 0 rgba(255,255,255,0.6) inset,
    0 32px 72px -24px color-mix(in srgb, var(--color-text) 22%, transparent),
    0 0 0 1px color-mix(in srgb, var(--color-text) 2%, transparent);
  overflow: hidden;
}
.contact-form-card::before {
  content: "";
  position: absolute;
  top: -120px; right: -120px;
  width: 360px; height: 360px; border-radius: 50%;
  background: radial-gradient(closest-side, color-mix(in srgb, var(--color-primary) 22%, transparent), transparent 70%);
  filter: blur(20px);
  opacity: 0.75;
  pointer-events: none;
}
.contact-form-card__head { position: relative; margin-bottom: 26px; }
.contact-form-card__eyebrow {
  font-size: 0.72rem; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.12em; color: var(--color-primary); margin: 0 0 8px;
}
.contact-form-card__head h3 {
  font-size: clamp(1.5rem, 2.2vw, 1.85rem);
  font-weight: 700; letter-spacing: -0.025em; margin: 0 0 8px; line-height: 1.1;
}
.contact-form-card__head p { font-size: 0.85rem; margin: 0; }

.contact-form { position: relative; display: flex; flex-direction: column; gap: 0; }
.contact-form__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
@media (max-width: 480px) {
  .contact-form__row { grid-template-columns: 1fr; }
}

.field {
  display: flex; flex-direction: column; gap: 6px;
  position: relative;
}
.field__label {
  font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted);
  letter-spacing: 0.01em;
}
.field__label em {
  font-style: normal; color: #ef4444; margin-left: 2px;
}
.field input,
.field select,
.field textarea {
  width: 100%;
  padding: 12px 14px;
  font-size: 0.88rem; color: var(--color-text);
  background: color-mix(in srgb, var(--color-bg-alt) 80%, transparent);
  border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
  border-radius: 12px;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  font-family: inherit;
  -webkit-appearance: none; appearance: none;
}
.field textarea { resize: vertical; min-height: 120px; line-height: 1.5; }
.field select {
  background-image:
    linear-gradient(45deg, transparent 50%, currentColor 50%),
    linear-gradient(135deg, currentColor 50%, transparent 50%);
  background-position: calc(100% - 20px) 52%, calc(100% - 14px) 52%;
  background-size: 6px 6px, 6px 6px;
  background-repeat: no-repeat;
  padding-right: 40px;
  color: var(--color-text);
}
.field input:hover,
.field select:hover,
.field textarea:hover {
  border-color: color-mix(in srgb, var(--color-text) 18%, transparent);
}
.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color: color-mix(in srgb, var(--color-primary) 60%, transparent);
  background: var(--color-bg);
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 12%, transparent);
}
.field input[aria-invalid="true"],
.field textarea[aria-invalid="true"] {
  border-color: color-mix(in srgb, #ef4444 55%, transparent);
  background: color-mix(in srgb, #ef4444 6%, var(--color-bg));
}

.contact-form__submit {
  margin-top: 24px;
  align-self: flex-start;
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 28px;
  border-radius: 999px;
  background: linear-gradient(180deg, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 85%, #000) 100%);
  color: #fff; font-size: 0.9rem; font-weight: 600;
  border: none; cursor: pointer;
  box-shadow:
    0 1px 0 rgba(255,255,255,0.2) inset,
    0 14px 28px -10px color-mix(in srgb, var(--color-primary) 70%, transparent),
    0 0 0 1px color-mix(in srgb, var(--color-primary) 50%, transparent);
  transition: transform 0.25s var(--ease-spring, cubic-bezier(.2,.8,.2,1)),
              box-shadow 0.3s ease, filter 0.2s ease;
}
.contact-form__submit:hover {
  transform: translateY(-1px);
  filter: brightness(1.06);
  box-shadow:
    0 1px 0 rgba(255,255,255,0.22) inset,
    0 22px 40px -12px color-mix(in srgb, var(--color-primary) 75%, transparent),
    0 0 0 1px color-mix(in srgb, var(--color-primary) 55%, transparent);
}
.contact-form__submit:active { transform: translateY(0) scale(0.985); filter: brightness(0.96); }

/* Success + errors */
.contact-form__success {
  display: flex; align-items: flex-start; gap: 12px;
