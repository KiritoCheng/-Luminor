      "blocks": {
        "hf_q1": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take and is it free?",
            "answer": "<p>Standard US shipping is 3–5 business days and <strong>free on orders over $49</strong>. International orders arrive in 7–14 business days depending on destination. Full details in the <a href=\"/pages/shipping-returns\">Shipping &amp; Returns policy</a>.</p>"
          }
        },
        "hf_q2": {
          "type": "question",
          "settings": {
            "question": "What is Luminor's return policy?",
            "answer": "<p><strong>30-day no-questions-asked returns.</strong> If any Luminor product doesn't meet your expectations — for any reason — send it back in any condition and we'll refund 100% of your purchase. Start on the <a href=\"/pages/shipping-returns\">returns page</a>.</p>"
          }
        },
        "hf_q3": {
          "type": "question",
          "settings": {
            "question": "Are Luminor products covered by warranty?",
            "answer": "<p>Yes. Every Luminor product is backed by a <strong>2-year limited warranty</strong> (lifetime craftsmanship guarantee on the Everyday line) covering any manufacturing defect. See the <a href=\"/pages/warranty\">warranty page</a> for full terms.</p>"
          }
        }
      },
