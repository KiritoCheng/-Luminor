    "home_faq": {
      "type": "home-mini-faq",
      "blocks": {
        "hf_q1": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take and is it free?",
            "answer": "<p>Standard US shipping is 3–5 business days and <strong>free on orders over $50</strong>. International orders arrive in 7–14 business days depending on destination. Full details in the <a href=\"/pages/shipping-returns\">Shipping &amp; Returns policy</a>.</p>"
          }
        },
        "hf_q2": {
          "type": "question",
          "settings": {
            "question": "What is Anode's return policy?",
            "answer": "<p><strong>30-day no-questions-asked returns.</strong> If any Anode product doesn't meet your expectations — for any reason — send it back in any condition and we'll refund 100% of your purchase. Start on the <a href=\"/pages/shipping-returns\">returns page</a>.</p>"
          }
        },
        "hf_q3": {
          "type": "question",
          "settings": {
            "question": "Are Anode products covered by warranty?",
            "answer": "<p>Yes. Every Anode product is backed by a <strong>1-year limited warranty</strong> covering any manufacturing defect. You can add <strong>Anode Care</strong> within 60 days of purchase to extend coverage to 3 years and include accidental damage. See the <a href=\"/pages/warranty\">warranty page</a> for full terms.</p>"
          }
        }
      },
      "block_order": [
        "hf_q1",
        "hf_q2",
        "hf_q3"
